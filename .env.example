# =============================================================================
# JARVIS environment template
# =============================================================================
# Copy this file to `.env` in the REPOSITORY ROOT and fill in the values:
#
#   cp .env.example .env
#
# The API reads only that root `.env`. Values placed in `.env.local`,
# `.env.development` or `.env.production` are NOT read.
#
# Two framework-owned files exist beside it. Both are gitignored:
#
#   packages/db/.env      DATABASE_URL only. The Prisma CLI (`pnpm db:migrate`,
#                         `pnpm db:generate`) looks for a .env next to the
#                         schema. Keep the value identical to the root one.
#   apps/web/.env.local   NEXT_PUBLIC_API_URL only. Next.js reads env files from
#                         its own folder. Optional locally: the web app falls
#                         back to http://localhost:3001/api/v1. In Docker it is
#                         a build argument instead.
#
# This file holds variable NAMES and placeholders. Never put a real value here.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jarvis?schema=public"

# Security
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# OpenAI — required in production. A production process refuses to start
# without it, or with this placeholder. A development API starts without it:
# health, sign-in and the non-AI features work, and chat answers
# 503 AI_PROVIDER_NOT_CONFIGURED. A blank value counts as not set.
OPENAI_API_KEY="sk-your-openai-api-key"

# OpenAI Embedding Model (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Environment: development | staging | production
NODE_ENV="development"

# API Server Port
API_PORT=3001

# Fallback port, used only when API_PORT is unset (some hosts inject PORT).
# PORT=3001

# Frontend URL (for CORS)
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google Integration (Optional)
# -----------------------------------------------------------------------------

# Google — one OAuth client for every Google service, with PROGRESSIVE scopes.
#
# The same client id serves Ads, Gmail, Drive, Calendar, YouTube, Sheets and
# Docs. Which scopes are requested is decided per connection, at runtime, from
# the catalogue in packages/core/src/integration-catalog.ts — NOT here, and
# never all of them at once. An initial connection asks for identity plus
# READ-ONLY scopes for the services the user actually selected; write access is
# a separate, explicit grant.
#
# Enable the APIs you intend to use in the Google Cloud console. An API that is
# not enabled fails at call time, not at consent time, which is why the
# Integration Center's Test Connection exists.
#
# Create an OAuth client of type "Web application" in the Google Cloud console
# and register GOOGLE_REDIRECT_URI there EXACTLY as written below; Google
# rejects any redirect that is not an exact match.
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/google/callback"

# Google Ads API developer token, from the Google Ads API Center. A new token
# starts with test-account-only access until Google approves basic access.
# GOOGLE_ADS_DEVELOPER_TOKEN="your-developer-token"

# Only when accounts are reached through a manager (MCC) account. Required to
# enumerate accessible customers; 10 digits, no dashes.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID="1234567890"

# -----------------------------------------------------------------------------
# Credential encryption at rest (required for any Google connection)
# -----------------------------------------------------------------------------
#
# AES-256-GCM key protecting third-party OAuth tokens in Postgres. Generate one:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Without this the API starts normally but mounts no /api/v1/google routes and
# registers no Google tools: tokens are never written unencrypted.
#
# To ROTATE: put the new key in JARVIS_ENCRYPTION_KEY, bump the version, and
# keep the previous key in JARVIS_ENCRYPTION_KEY_RETIRED so existing rows still
# decrypt. No migration is needed.
# JARVIS_ENCRYPTION_KEY="base64-of-32-random-bytes"
# JARVIS_ENCRYPTION_KEY_VERSION="1"
# JARVIS_ENCRYPTION_KEY_RETIRED="1:previous-base64-key"

# -----------------------------------------------------------------------------
# Meta / Facebook Integration (Optional)
# -----------------------------------------------------------------------------

# META_ACCESS_TOKEN="your-meta-access-token"
# META_AD_ACCOUNT_ID="act_123456789"
# META_GRAPH_API_VERSION="v21.0"

# -----------------------------------------------------------------------------
# n8n Automation Integration (Optional)
# -----------------------------------------------------------------------------

# Sprint 5.4 — n8n automation (JARVIS triggers workflows and receives results).
#
# TWO SECRETS AUTHENTICATING OPPOSITE DIRECTIONS. Do not interchange them:
#
#   N8N_API_KEY         JARVIS -> n8n. Sent as X-N8N-API-KEY on the outbound
#                       trigger. Workflow authors can often read it.
#   N8N_CALLBACK_SECRET n8n -> JARVIS. The HMAC key a workflow uses to sign its
#                       result callback. This is the ONLY thing that
#                       authenticates an inbound callback, and the API key is
#                       explicitly rejected for that purpose.
#
# All three must be set or the n8n routes and the trigger tool stay
# unregistered; the API starts normally either way.
# N8N_BASE_URL="http://localhost:5678"
# N8N_API_KEY="your-n8n-api-key"
# N8N_CALLBACK_SECRET="a-long-random-string-you-choose"
# N8N_TIMEOUT_MS="15000"
#
# Workflows must be registered as N8nWorkflow rows (per user) before they can be
# triggered: the caller passes a JARVIS workflow id, never a URL or webhook
# path, so a request cannot aim the trigger at an arbitrary host.
#
# A workflow reports its result by POSTing to
#   https://<your-host>/api/v1/n8n/callback
# with header  X-Jarvis-Signature: sha256=<HMAC-SHA256(rawBody, callbackSecret)>
# and body     { "eventId", "executionId", "status", "summary"?, "errorMessage"? }
# where executionId is the jarvisExecutionId supplied on the trigger.

# -----------------------------------------------------------------------------
# WhatsApp Business Integration (Optional)
# -----------------------------------------------------------------------------

# Sprint 5.3 — WhatsApp Business Cloud API (Meta).
#
# FOUR DISTINCT SECRETS with different jobs. Do not interchange them:
#
#   ACCESS_TOKEN     authenticates US to Meta, for outbound sends.
#   APP_SECRET       verifies META to US — the HMAC key for X-Hub-Signature-256.
#                    This is the ONLY thing that authenticates a webhook payload.
#   VERIFY_TOKEN     an arbitrary string echoed once when registering the
#                    webhook. It proves nothing about later requests and is
#                    NOT a signature key.
#   PHONE_NUMBER_ID  which business number sends.
#
# All four must be present or the WhatsApp routes and the send tool stay
# unregistered; the API starts normally either way.
# WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
# WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
# WHATSAPP_APP_SECRET="your-meta-app-secret"
# WHATSAPP_VERIFY_TOKEN="a-random-string-you-choose"
# WHATSAPP_API_VERSION="v21.0"
#
# Register the webhook in the Meta app dashboard against
#   https://<your-host>/api/v1/whatsapp/webhook
# and subscribe to the "messages" field. Inbound messages are only stored once a
# row in WhatsAppAccount claims the phone_number_id for a JARVIS user.

# ---------------------------------------------------------------------------
# V3 — Google Maps Platform (dashboard map widget)
#
# TWO SEPARATE KEYS, on purpose. Reusing one unrestricted key for both turns a
# referrer-restricted browser key into a billable server credential that anyone
# can lift out of the page.
#
#   BROWSER key — loads the Maps JavaScript API. It necessarily reaches the
#   browser, so it is not a secret. Restrict it in the Google console to the
#   Maps JavaScript API and to your origin(s) via an HTTP referrer restriction.
#   JARVIS serves it from an authenticated endpoint rather than inlining it in
#   the JS bundle, so it is not fetchable without logging in.
#
#   SERVER key — Geocoding, Places and Routes, called only from the API. Never
#   sent to a client. Restrict by IP and to those APIs.
#
# Without the BROWSER key the map widget stays on the dashboard and shows setup
# guidance; it never draws a substitute map. Without the SERVER key, geocoding
# and routing fall back to OpenStreetMap/OSRM and every result says so.
# GOOGLE_MAPS_BROWSER_KEY="AIza...-restrict-to-your-origin"
# GOOGLE_MAPS_SERVER_KEY="AIza...-restrict-by-ip"
#
# MONTHLY REQUEST CEILING enforced by JARVIS itself.
#
# Counts server-side Places, Geocoding and Routes calls. At 70/85/90/95% the
# admin view escalates a warning; at 100% JARVIS stops calling Google entirely
# and returns "Google Maps monthly usage limit reached." rather than quietly
# switching provider.
#
# This is a JARVIS SAFETY NET, not a billing control. It cannot see Maps
# JavaScript API tile loads, which happen in the browser and are billed by
# Google directly. Set a Cloud budget alert and a per-API quota cap as well.
#
# Unset, unparseable or negative falls back to 70000 — a typo must not be the
# thing that removes the ceiling. 0 is honoured, and means "block everything".
# GOOGLE_MAPS_MONTHLY_LIMIT=70000

# ---------------------------------------------------------------------------
# V3 — Indian market indices (NIFTY 50 / BANKNIFTY)
#
# Real-time index data is licensed. With no provider configured the widget
# reports UNAVAILABLE and makes no network call — it never scrapes NSE.
# MARKET_INDICES_API_URL="https://your-licensed-vendor.example/v1"
# MARKET_INDICES_API_KEY="your-vendor-key"

# ---------------------------------------------------------------------------
# ElevenLabs speech synthesis (optional).
#
# When BOTH the key and the voice id are set, ElevenLabs becomes the text-to-
# speech provider. Transcription stays on whisper-1 either way — that model was
# chosen by measurement for Hinglish and is not part of this switch.
#
# Absent either value the OpenAI voice is used, so this is an upgrade and never
# a hard dependency. The lines below are commented out so that copying this
# template does not switch speech to ElevenLabs with a placeholder key.
#
# THE KEY IS SERVER-ONLY. It is read by the API process, sent to ElevenLabs in
# a request header, and never reaches a browser bundle, an API response or a
# log line. Do not prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=your_server_side_api_key
# ELEVENLABS_VOICE_ID=tmbml5fDfdur7yY0gzHA
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
#
# Delivery. Applied on every request; safe to leave unset for the defaults.
# ELEVENLABS_STABILITY=0.62
# ELEVENLABS_SIMILARITY_BOOST=0.88
# ELEVENLABS_STYLE=0.18
# ELEVENLABS_SPEAKER_BOOST=true
# ELEVENLABS_SPEED=0.94

# -----------------------------------------------------------------------------
# AI models, timeouts and retries (optional — defaults shown)
# -----------------------------------------------------------------------------
# OPENAI_DEFAULT_MODEL="gpt-4o"
# OPENAI_VISION_MODEL="gpt-4o-mini"
# OPENAI_TIMEOUT_MS=30000
# OPENAI_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Voice (optional)
# -----------------------------------------------------------------------------
# Speech-to-text runs on OpenAI; text-to-speech uses OpenAI unless the
# ElevenLabs block above is filled in. Defaults and hard ceilings live in
# packages/config/src/index.ts (VOICE_DEFAULTS; 6 MB audio, 4096 TTS characters).
# VOICE_ENABLED=
# VOICE_MAX_AUDIO_BYTES=
# VOICE_MAX_TTS_CHARS=
# OPENAI_STT_MODEL=
# OPENAI_STT_LANGUAGE=
# OPENAI_TTS_MODEL=
# OPENAI_TTS_VOICE=
# OPENAI_TTS_SPEED=
# OPENAI_TTS_INSTRUCTIONS=

# -----------------------------------------------------------------------------
# Sign-in, sessions and runtime (optional)
# -----------------------------------------------------------------------------
# Public origin of the API, used to build the Google sign-in redirect.
# Default: http://localhost:<API_PORT>
# API_PUBLIC_URL="http://localhost:3001"
#
# Override for the Google sign-in redirect.
# Default: <API_PUBLIC_URL>/api/v1/auth/google/callback
# GOOGLE_SIGNIN_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"
#
# Name of the HttpOnly refresh-token cookie. Give each stack on one host its
# own name: cookies ignore the port. Default: jarvis_rt
# AUTH_COOKIE_NAME="jarvis_rt"
#
# Local-development allowance read by the cookie and origin checks; read
# apps/api/src/lib/auth-cookies.ts before changing it.
# JARVIS_ALLOW_LOCAL_ORIGIN="false"
#
# Number of reverse proxies in front of the API. Off by default: trusting
# X-Forwarded-For with no proxy lets any client claim any IP address.
# TRUST_PROXY=1
#
# Graceful-shutdown grace period in milliseconds. Default: 30000
# JARVIS_SHUTDOWN_GRACE_MS=30000
#
# How often the outcome measurement worker sweeps for due records, in
# milliseconds. 0 disables the background sweep. Default: 300000 (5 minutes)
# JARVIS_OUTCOME_WORKER_INTERVAL_MS=300000
#
# Tells the system monitor it runs inside a container (also assumed when
# NODE_ENV=production).
# JARVIS_IN_CONTAINER="true"

# -----------------------------------------------------------------------------
# Browser automation (optional)
# -----------------------------------------------------------------------------
# Off unless BROWSER_ENABLED=true. Uses an installed Chrome or Edge, found
# automatically unless CHROME_PATH is set. Defaults shown where the code sets one.
# BROWSER_ENABLED="true"
# CHROME_PATH=""
# BROWSER_HEADLESS=
# BROWSER_DOMAIN_ALLOWLIST=
# BROWSER_DOWNLOAD_DIR=
# BROWSER_NAVIGATION_TIMEOUT_MS=20000
# BROWSER_SESSION_TIMEOUT_MS=60000
# BROWSER_MAX_SESSIONS=2
# BROWSER_MAX_EXTRACT_CHARS=20000
# BROWSER_MAX_DOWNLOAD_BYTES=10485760

# -----------------------------------------------------------------------------
# Anthropic Claude adapter — NOT WIRED
# -----------------------------------------------------------------------------
# packages/ai-anthropic exists but nothing imports it, so these currently have
# no effect. Listed so the names are not reinvented when it is wired in.
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# CLAUDE_DEFAULT_MODEL=""
# CLAUDE_TIMEOUT_MS=30000
# CLAUDE_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Web app — set in apps/web/.env.local, not here
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
