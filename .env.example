# =============================================================================
# JARVIS Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jarvis?schema=public"

# Security
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"

# OpenAI Embedding Model (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Environment: development | staging | production
NODE_ENV="development"

# API Server Port
API_PORT=3001

# Frontend URL (for CORS)
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google Integration (Optional)
# -----------------------------------------------------------------------------

# Sprint 5.2 — Google Ads (READ-ONLY) via OAuth 2.0 + PKCE.
#
# Create an OAuth client of type "Web application" in the Google Cloud console
# and register GOOGLE_REDIRECT_URI there EXACTLY as written below; Google
# rejects any redirect that is not an exact match.
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/google/callback"

# Google Ads API developer token, from the Google Ads API Center. A new token
# starts with test-account-only access until Google approves basic access.
# GOOGLE_ADS_DEVELOPER_TOKEN="your-developer-token"

# Only when accounts are reached through a manager (MCC) account. Required to
# enumerate accessible customers; 10 digits, no dashes.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID="1234567890"

# -----------------------------------------------------------------------------
# Credential encryption at rest (required for any Google connection)
# -----------------------------------------------------------------------------
#
# AES-256-GCM key protecting third-party OAuth tokens in Postgres. Generate one:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Without this the API starts normally but mounts no /api/v1/google routes and
# registers no Google tools: tokens are never written unencrypted.
#
# To ROTATE: put the new key in JARVIS_ENCRYPTION_KEY, bump the version, and
# keep the previous key in JARVIS_ENCRYPTION_KEY_RETIRED so existing rows still
# decrypt. No migration is needed.
# JARVIS_ENCRYPTION_KEY="base64-of-32-random-bytes"
# JARVIS_ENCRYPTION_KEY_VERSION="1"
# JARVIS_ENCRYPTION_KEY_RETIRED="1:previous-base64-key"

# -----------------------------------------------------------------------------
# Meta / Facebook Integration (Optional)
# -----------------------------------------------------------------------------

# META_ACCESS_TOKEN="your-meta-access-token"
# META_AD_ACCOUNT_ID="act_123456789"
# META_GRAPH_API_VERSION="v21.0"

# -----------------------------------------------------------------------------
# n8n Automation Integration (Optional)
# -----------------------------------------------------------------------------

# Sprint 5.4 — n8n automation (JARVIS triggers workflows and receives results).
#
# TWO SECRETS AUTHENTICATING OPPOSITE DIRECTIONS. Do not interchange them:
#
#   N8N_API_KEY         JARVIS -> n8n. Sent as X-N8N-API-KEY on the outbound
#                       trigger. Workflow authors can often read it.
#   N8N_CALLBACK_SECRET n8n -> JARVIS. The HMAC key a workflow uses to sign its
#                       result callback. This is the ONLY thing that
#                       authenticates an inbound callback, and the API key is
#                       explicitly rejected for that purpose.
#
# All three must be set or the n8n routes and the trigger tool stay
# unregistered; the API starts normally either way.
# N8N_BASE_URL="http://localhost:5678"
# N8N_API_KEY="your-n8n-api-key"
# N8N_CALLBACK_SECRET="a-long-random-string-you-choose"
# N8N_TIMEOUT_MS="15000"
#
# Workflows must be registered as N8nWorkflow rows (per user) before they can be
# triggered: the caller passes a JARVIS workflow id, never a URL or webhook
# path, so a request cannot aim the trigger at an arbitrary host.
#
# A workflow reports its result by POSTing to
#   https://<your-host>/api/v1/n8n/callback
# with header  X-Jarvis-Signature: sha256=<HMAC-SHA256(rawBody, callbackSecret)>
# and body     { "eventId", "executionId", "status", "summary"?, "errorMessage"? }
# where executionId is the jarvisExecutionId supplied on the trigger.

# -----------------------------------------------------------------------------
# WhatsApp Business Integration (Optional)
# -----------------------------------------------------------------------------

# Sprint 5.3 — WhatsApp Business Cloud API (Meta).
#
# FOUR DISTINCT SECRETS with different jobs. Do not interchange them:
#
#   ACCESS_TOKEN     authenticates US to Meta, for outbound sends.
#   APP_SECRET       verifies META to US — the HMAC key for X-Hub-Signature-256.
#                    This is the ONLY thing that authenticates a webhook payload.
#   VERIFY_TOKEN     an arbitrary string echoed once when registering the
#                    webhook. It proves nothing about later requests and is
#                    NOT a signature key.
#   PHONE_NUMBER_ID  which business number sends.
#
# All four must be present or the WhatsApp routes and the send tool stay
# unregistered; the API starts normally either way.
# WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
# WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
# WHATSAPP_APP_SECRET="your-meta-app-secret"
# WHATSAPP_VERIFY_TOKEN="a-random-string-you-choose"
# WHATSAPP_API_VERSION="v21.0"
#
# Register the webhook in the Meta app dashboard against
#   https://<your-host>/api/v1/whatsapp/webhook
# and subscribe to the "messages" field. Inbound messages are only stored once a
# row in WhatsAppAccount claims the phone_number_id for a JARVIS user.

# -----------------------------------------------------------------------------
# GitHub Integration (Optional)
# -----------------------------------------------------------------------------

# GITHUB_TOKEN="ghp_your-github-token"

# -----------------------------------------------------------------------------
# Redis (Optional - for caching)
# -----------------------------------------------------------------------------

# REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# V3 — Google Maps Platform (dashboard map widget)
#
# TWO SEPARATE KEYS, on purpose. Reusing one unrestricted key for both turns a
# referrer-restricted browser key into a billable server credential that anyone
# can lift out of the page.
#
#   BROWSER key — loads the Maps JavaScript API. It necessarily reaches the
#   browser, so it is not a secret. Restrict it in the Google console to the
#   Maps JavaScript API and to your origin(s) via an HTTP referrer restriction.
#   JARVIS serves it from an authenticated endpoint rather than inlining it in
#   the JS bundle, so it is not fetchable without logging in.
#
#   SERVER key — Geocoding, Places and Routes, called only from the API. Never
#   sent to a client. Restrict by IP and to those APIs.
#
# Without the BROWSER key the map widget stays on the dashboard and shows setup
# guidance; it never draws a substitute map. Without the SERVER key, geocoding
# and routing fall back to OpenStreetMap/OSRM and every result says so.
# GOOGLE_MAPS_BROWSER_KEY="AIza...-restrict-to-your-origin"
# GOOGLE_MAPS_SERVER_KEY="AIza...-restrict-by-ip"

# ---------------------------------------------------------------------------
# V3 — Indian market indices (NIFTY 50 / BANKNIFTY)
#
# Real-time index data is licensed. With no provider configured the widget
# reports UNAVAILABLE and makes no network call — it never scrapes NSE.
# MARKET_INDICES_API_URL="https://your-licensed-vendor.example/v1"
# MARKET_INDICES_API_KEY="your-vendor-key"
