# =============================================================================
# JARVIS environment template
# =============================================================================
# Copy this file to `.env` in the REPOSITORY ROOT and fill in the values:
#
#   cp .env.example .env
#
# The API reads only that root `.env`. Values placed in `.env.local`,
# `.env.development` or `.env.production` are NOT read.
#
# Two framework-owned files exist beside it. Both are gitignored:
#
#   packages/db/.env      DATABASE_URL only. The Prisma CLI (`pnpm db:migrate`,
#                         `pnpm db:generate`) looks for a .env next to the
#                         schema. Keep the value identical to the root one.
#   apps/web/.env.local   NEXT_PUBLIC_API_URL only. Next.js reads env files from
#                         its own folder. Optional locally: the web app falls
#                         back to http://localhost:3001/api/v1. In Docker it is
#                         a build argument instead.
#
# This file holds variable NAMES and placeholders. Never put a real value here.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Database — PostgreSQL with pgvector. A production process refuses to start
# on this placeholder, or on a value that is not a postgresql:// URL that
# names a host.
DATABASE_URL="postgresql://user:password@localhost:5432/jarvis?schema=public"

# Security
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# OpenAI — required in production. A production process refuses to start
# without it, or with this placeholder. A development API starts without it:
# health, sign-in and the non-AI features work, and chat answers
# 503 AI_PROVIDER_NOT_CONFIGURED. A blank value counts as not set.
OPENAI_API_KEY="sk-your-openai-api-key"

# OpenAI Embedding Model (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Environment: development | staging | production
NODE_ENV="development"

# API Server Port
API_PORT=3001

# Fallback port, used only when API_PORT is unset (some hosts inject PORT).
# PORT=3001

# Frontend URL (for CORS)
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google Integration (Optional)
# -----------------------------------------------------------------------------

# Google — one OAuth client for every Google service, with PROGRESSIVE scopes.
#
# The same client id serves Ads, Gmail, Drive, Calendar, YouTube, Sheets and
# Docs. Which scopes are requested is decided per connection, at runtime, from
# the catalogue in packages/core/src/integration-catalog.ts — NOT here, and
# never all of them at once. An initial connection asks for identity plus
# READ-ONLY scopes for the services the user actually selected; write access is
# a separate, explicit grant.
#
# Enable the APIs you intend to use in the Google Cloud console. An API that is
# not enabled fails at call time, not at consent time, which is why the
# Integration Center's Test Connection exists.
#
# Create an OAuth client of type "Web application" in the Google Cloud console
# and register GOOGLE_REDIRECT_URI there EXACTLY as written below; Google
# rejects any redirect that is not an exact match.
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/google/callback"

# Google Ads API developer token, from the Google Ads API Center. A new token
# starts with test-account-only access until Google approves basic access.
# GOOGLE_ADS_DEVELOPER_TOKEN="your-developer-token"

# Only when accounts are reached through a manager (MCC) account. Required to
# enumerate accessible customers; 10 digits, no dashes.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID="1234567890"

# -----------------------------------------------------------------------------
# Credential encryption at rest (required for any Google connection)
# -----------------------------------------------------------------------------
#
# AES-256-GCM key protecting third-party OAuth tokens in Postgres. Generate one:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Without this the API starts normally but mounts no /api/v1/google routes and
# registers no Google tools: tokens are never written unencrypted.
#
# To ROTATE: put the new key in JARVIS_ENCRYPTION_KEY, bump the version, and
# keep the previous key in JARVIS_ENCRYPTION_KEY_RETIRED so existing rows still
# decrypt. No migration is needed.
# JARVIS_ENCRYPTION_KEY="base64-of-32-random-bytes"
# JARVIS_ENCRYPTION_KEY_VERSION="1"
# JARVIS_ENCRYPTION_KEY_RETIRED="1:previous-base64-key"

# -----------------------------------------------------------------------------
# Meta / Facebook Integration (Optional)
# -----------------------------------------------------------------------------

# META_ACCESS_TOKEN="your-meta-access-token"
# META_AD_ACCOUNT_ID="act_123456789"
# META_GRAPH_API_VERSION="v21.0"
#
# Phase 15 — publishing to a Facebook Page. OFF unless this is exactly "true".
#
# The two Meta variables above let JARVIS READ the ad account. They do not, on
# their own, let it POST anything: publishing is switched on separately, here,
# because a deployment should become able to post publicly only when its
# operator says so. Absent, empty, "1", "yes" or "TRUE" all leave it off.
#
# While it is off: no publish tool is registered, the Marketing page draws no
# Publish button and says publishing is switched off, the publish endpoints
# answer 503, no agent is offered a publish tool, and no approval for a publish
# can be created.
#
# With it on AND the two Meta variables set, JARVIS can publish a text post to a
# Facebook Page — always behind an approval of the exact text and Page. For that
# the token must also be allowed to list Pages, read their posts and create
# posts on them (Meta's pages_show_list, pages_read_engagement and
# pages_manage_posts), and there must be at least one Page it may create content
# on. Where it cannot, the publish check says so for that item.
# MARKETING_PUBLISH_ENABLED="true"

# -----------------------------------------------------------------------------
# n8n Automation Integration (Optional)
# -----------------------------------------------------------------------------

# Sprint 5.4 — n8n automation (JARVIS triggers workflows and receives results).
#
# TWO SECRETS AUTHENTICATING OPPOSITE DIRECTIONS. Do not interchange them:
#
#   N8N_API_KEY         JARVIS -> n8n. Sent as X-N8N-API-KEY on the outbound
#                       trigger. Workflow authors can often read it.
#   N8N_CALLBACK_SECRET n8n -> JARVIS. The HMAC key a workflow uses to sign its
#                       result callback. This is the ONLY thing that
#                       authenticates an inbound callback, and the API key is
#                       explicitly rejected for that purpose.
#
# All three must be set or the n8n routes and the trigger tool stay
# unregistered; the API starts normally either way.
# N8N_BASE_URL="http://localhost:5678"
# N8N_API_KEY="your-n8n-api-key"
# N8N_CALLBACK_SECRET="a-long-random-string-you-choose"
# N8N_TIMEOUT_MS="15000"
#
# Workflows must be registered as N8nWorkflow rows (per user) before they can be
# triggered: the caller passes a JARVIS workflow id, never a URL or webhook
# path, so a request cannot aim the trigger at an arbitrary host.
#
# A workflow reports its result by POSTing to
#   https://<your-host>/api/v1/n8n/callback
# with header  X-Jarvis-Signature: sha256=<HMAC-SHA256(rawBody, callbackSecret)>
# and body     { "eventId", "executionId", "status", "summary"?, "errorMessage"? }
# where executionId is the jarvisExecutionId supplied on the trigger.

# -----------------------------------------------------------------------------
# n8n MCP (Optional) — discovering and invoking automation tools
# -----------------------------------------------------------------------------
# The SECOND n8n surface. The REST API above answers "which workflows exist and
# how did they run"; MCP answers "which automation tools may be discovered and
# invoked". Both are needed: neither surface can do the other's job.
#
# OFF UNLESS SWITCHED ON. N8N_MCP_ENABLED must be exactly "true". While it is
# off no connection is built and no tool is discovered, so there is no
# half-configured surface to authenticate against.
#
# N8N_MCP_TOKEN IS NOT N8N_API_KEY. n8n's instance-level MCP server accepts
# either an OAuth 2.1 grant (recommended) or a personal access token sent as
# `Authorization: Bearer` — the "API key" tab in n8n's "Connect a client"
# dialog (n8n >= 2.33). JARVIS implements only the bearer path. A REST API key
# is never accepted as an MCP token; the separate name keeps the two apart.
# N8N_MCP_ENABLED="false"
# N8N_MCP_TOKEN=""
#
# The endpoint is DERIVED from N8N_BASE_URL (base + /mcp-server/http), so it is
# not set here. Override it only for a self-hosted instance that mounts its MCP
# server elsewhere; business logic never names a host. Must be HTTPS.
# N8N_MCP_ENDPOINT=""
#
# A self-hosted deployment that serves MCP from a different host than the REST
# API lists those origins here, comma-separated. The N8N_BASE_URL origin is
# always allowed and needs no entry.
# N8N_MCP_ALLOWED_ORIGINS=""
#
# Per-operation ceiling for one discovery or one invocation.
# N8N_MCP_TIMEOUT_MS="15000"

# -----------------------------------------------------------------------------
# OmniRoute AI Gateway (Optional)
# -----------------------------------------------------------------------------
# A self-hosted gateway: one OpenAI-compatible /v1 endpoint in front of many
# model providers. JARVIS reports its health on the Integrations page; the chat
# adapter does NOT route through it.
#
#   OMNIROUTE_BASE_URL  The /v1 base. A bare origin is completed with /v1. It is
#                       shown on the integration card, so it must not embed a
#                       username or password. From inside Docker the host's
#                       gateway is http://host.docker.internal:20128/v1.
#   OMNIROUTE_API_KEY   An ENDPOINT key from OmniRoute's Endpoints page — never a
#                       provider key. Set REQUIRE_API_KEY=true on the gateway, or
#                       it answers without one and the key is not checked at all.
#
# Both must be set, or the card reports the gateway as not configured.
# OMNIROUTE_BASE_URL="http://localhost:20128/v1"
# OMNIROUTE_API_KEY="your-omniroute-endpoint-key"

# -----------------------------------------------------------------------------
# WhatsApp Business Integration (Optional)
# -----------------------------------------------------------------------------

# Sprint 5.3 — WhatsApp Business Cloud API (Meta).
#
# FOUR DISTINCT SECRETS with different jobs. Do not interchange them:
#
#   ACCESS_TOKEN     authenticates US to Meta, for outbound sends.
#   APP_SECRET       verifies META to US — the HMAC key for X-Hub-Signature-256.
#                    This is the ONLY thing that authenticates a webhook payload.
#   VERIFY_TOKEN     an arbitrary string echoed once when registering the
#                    webhook. It proves nothing about later requests and is
#                    NOT a signature key.
#   PHONE_NUMBER_ID  which business number sends.
#
# All four must be present or the WhatsApp routes and the send tool stay
# unregistered; the API starts normally either way.
# WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
# WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
# WHATSAPP_APP_SECRET="your-meta-app-secret"
# WHATSAPP_VERIFY_TOKEN="a-random-string-you-choose"
# WHATSAPP_API_VERSION="v21.0"
#
# Register the webhook in the Meta app dashboard against
#   https://<your-host>/api/v1/whatsapp/webhook
# and subscribe to the "messages" field. Inbound messages are only stored once a
# row in WhatsAppAccount claims the phone_number_id for a JARVIS user.

# ---------------------------------------------------------------------------
# V3 — Google Maps Platform (dashboard map widget)
#
# TWO SEPARATE KEYS, on purpose. Reusing one unrestricted key for both turns a
# referrer-restricted browser key into a billable server credential that anyone
# can lift out of the page.
#
#   BROWSER key — loads the Maps JavaScript API. It necessarily reaches the
#   browser, so it is not a secret. Restrict it in the Google console to the
#   Maps JavaScript API and to your origin(s) via an HTTP referrer restriction.
#   JARVIS serves it from an authenticated endpoint rather than inlining it in
#   the JS bundle, so it is not fetchable without logging in.
#
#   SERVER key — Geocoding, Places and Routes, called only from the API. Never
#   sent to a client. Restrict by IP and to those APIs.
#
# Without the BROWSER key the map widget stays on the dashboard and shows setup
# guidance; it never draws a substitute map. Without the SERVER key, geocoding
# and routing fall back to OpenStreetMap/OSRM and every result says so.
# GOOGLE_MAPS_BROWSER_KEY="AIza...-restrict-to-your-origin"
# GOOGLE_MAPS_SERVER_KEY="AIza...-restrict-by-ip"
#
# MONTHLY REQUEST CEILING enforced by JARVIS itself.
#
# Counts server-side Places, Geocoding and Routes calls. At 70/85/90/95% the
# admin view escalates a warning; at 100% JARVIS stops calling Google entirely
# and returns "Google Maps monthly usage limit reached." rather than quietly
# switching provider.
#
# This is a JARVIS SAFETY NET, not a billing control. It cannot see Maps
# JavaScript API tile loads, which happen in the browser and are billed by
# Google directly. Set a Cloud budget alert and a per-API quota cap as well.
#
# Unset, unparseable or negative falls back to 70000 — a typo must not be the
# thing that removes the ceiling. 0 is honoured, and means "block everything".
# GOOGLE_MAPS_MONTHLY_LIMIT=70000

# ---------------------------------------------------------------------------
# V3 — Indian market indices (NIFTY 50 / BANKNIFTY)
#
# Real-time index data is licensed. With no provider configured the widget
# reports UNAVAILABLE and makes no network call — it never scrapes NSE.
# MARKET_INDICES_API_URL="https://your-licensed-vendor.example/v1"
# MARKET_INDICES_API_KEY="your-vendor-key"

# ---------------------------------------------------------------------------
# ElevenLabs speech synthesis (optional).
#
# When BOTH the key and the voice id are set, ElevenLabs becomes the text-to-
# speech provider. Transcription stays on whisper-1 either way — that model was
# chosen by measurement for Hinglish and is not part of this switch.
#
# Absent either value the OpenAI voice is used, so this is an upgrade and never
# a hard dependency. The lines below are commented out so that copying this
# template does not switch speech to ElevenLabs with a placeholder key.
#
# THE KEY IS SERVER-ONLY. It is read by the API process, sent to ElevenLabs in
# a request header, and never reaches a browser bundle, an API response or a
# log line. Do not prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=your_server_side_api_key
# ELEVENLABS_VOICE_ID=tmbml5fDfdur7yY0gzHA
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
#
# Delivery. Applied on every request; safe to leave unset for the defaults.
# ELEVENLABS_STABILITY=0.62
# ELEVENLABS_SIMILARITY_BOOST=0.88
# ELEVENLABS_STYLE=0.18
# ELEVENLABS_SPEAKER_BOOST=true
# ELEVENLABS_SPEED=0.94

# -----------------------------------------------------------------------------
# AI models, timeouts and retries (optional — defaults shown)
# -----------------------------------------------------------------------------
# OPENAI_DEFAULT_MODEL="gpt-4o"
# OPENAI_VISION_MODEL="gpt-4o-mini"
# OPENAI_TIMEOUT_MS=30000
# OPENAI_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Voice (optional)
# -----------------------------------------------------------------------------
# Speech-to-text runs on OpenAI; text-to-speech uses OpenAI unless the
# ElevenLabs block above is filled in. Defaults and hard ceilings live in
# packages/config/src/index.ts (VOICE_DEFAULTS; 6 MB audio, 4096 TTS characters).
# VOICE_ENABLED=
# VOICE_MAX_AUDIO_BYTES=
# VOICE_MAX_TTS_CHARS=
# OPENAI_STT_MODEL=
# OPENAI_STT_LANGUAGE=
# OPENAI_TTS_MODEL=
# OPENAI_TTS_VOICE=
# OPENAI_TTS_SPEED=
# OPENAI_TTS_INSTRUCTIONS=

# -----------------------------------------------------------------------------
# Sign-in, sessions and runtime (optional)
# -----------------------------------------------------------------------------
# Public origin of the API, used to build the Google sign-in redirect.
# Default: http://localhost:<API_PORT>
# API_PUBLIC_URL="http://localhost:3001"
#
# Override for the Google sign-in redirect.
# Default: <API_PUBLIC_URL>/api/v1/auth/google/callback
# GOOGLE_SIGNIN_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"
#
# Name of the HttpOnly refresh-token cookie. Give each stack on one host its
# own name: cookies ignore the port. Default: jarvis_rt
# AUTH_COOKIE_NAME="jarvis_rt"
#
# Local-development allowance read by the cookie and origin checks; read
# apps/api/src/lib/auth-cookies.ts before changing it.
# JARVIS_ALLOW_LOCAL_ORIGIN="false"
#
# Number of reverse proxies in front of the API. Off by default: trusting
# X-Forwarded-For with no proxy lets any client claim any IP address.
# TRUST_PROXY=1
#
# Graceful-shutdown grace period in milliseconds. Default: 30000
# JARVIS_SHUTDOWN_GRACE_MS=30000
#
# How often the outcome measurement worker sweeps for due records, in
# milliseconds. 0 disables the background sweep. Default: 300000 (5 minutes)
# JARVIS_OUTCOME_WORKER_INTERVAL_MS=300000
#
# How often the task scheduler sweeps for scheduled tasks that are due, in
# milliseconds. This interval is the worst-case lateness of a scheduled task.
# 0 disables scheduled execution entirely. Default: 60000 (1 minute)
# JARVIS_TASK_SCHEDULER_INTERVAL_MS=60000
#
# How often expired memories are purged, in milliseconds. A learned memory
# expires 90 days after you last stated it and is hidden from recall at once;
# the sweep deletes it 30 days after that. 0 disables the purge: expired
# memories then stay hidden but are never deleted. Default: 21600000 (6 hours)
# JARVIS_MEMORY_RETENTION_INTERVAL_MS=21600000
#
# How old a scheduler claim must be before it is treated as abandoned and
# re-armed for another attempt. A claimed task is PENDING only between the
# claim and the start of execution, a window bounded by the planner's 20s
# timeout, so anything well above that is safe. 0 disables claim recovery.
# THE DEFAULT IS A DEVELOPMENT VALUE - choose one explicitly in production.
# Default: 300000 (5 minutes)
# JARVIS_TASK_CLAIM_RECOVERY_AFTER_MS=300000
#
# Grace period ADDED TO the ToolExecutor's enforced 30s execution deadline
# before a RUNNING task's outcome is reconciled from audit evidence.
#   total stale threshold = 30000 + this value
# A task inside that window is left alone. Past it, the audit row decides:
# success -> COMPLETED, failure -> FAILED, no evidence -> UNRESOLVED (never
# retried). 0 disables RUNNING recovery. Default: 120000 (2 minutes)
# JARVIS_TASK_RUNNING_RECOVERY_GRACE_MS=120000
#
# Tells the system monitor it runs inside a container (also assumed when
# NODE_ENV=production).
# JARVIS_IN_CONTAINER="true"

# -----------------------------------------------------------------------------
# Browser automation (optional)
# -----------------------------------------------------------------------------
# Off unless BROWSER_ENABLED=true. Uses an installed Chrome or Edge, found
# automatically unless CHROME_PATH is set. Defaults shown where the code sets one.
#
# Phase 15 — BROWSER_ENABLED=true also switches on the marketing page reads
# (SEO audit, competitor page). Those need NO Chrome: they are plain HTTP, under
# the same navigation policy and BROWSER_DOMAIN_ALLOWLIST as browsing, and are
# limited to 20 reads per user per 10 minutes (a slot is reserved before each
# page is fetched). Without it the two research tools are not registered and the
# Marketing page shows no research form.
# BROWSER_ENABLED="true"
# CHROME_PATH=""
# BROWSER_HEADLESS=
# BROWSER_DOMAIN_ALLOWLIST=
# BROWSER_DOWNLOAD_DIR=
# BROWSER_NAVIGATION_TIMEOUT_MS=20000
# BROWSER_SESSION_TIMEOUT_MS=60000
# BROWSER_MAX_SESSIONS=2
# BROWSER_MAX_EXTRACT_CHARS=20000
# BROWSER_MAX_DOWNLOAD_BYTES=10485760
#
# Phase 19.4 — browser artifacts (downloads and screenshots) are kept in a
# durable store under BROWSER_DOWNLOAD_DIR (default storage/browser, relative to
# the API's working directory). Each belongs to one user AND one Organization;
# another user's or Organization's id is answered as not found. They survive a
# restart until the retention below passes, and are then refused and swept.
#
# REQUIRED to use the browser: BROWSER_ARTIFACT_RETENTION_HOURS has NO default.
# Without it no browser tool is registered (logged as
# browser_registration_skipped). How long to keep artifacts is your policy, not
# the code's. 1 to 8784 hours.
# BROWSER_ARTIFACT_RETENTION_HOURS=
# Quotas, each enforced under a lock, so writes that arrive together cannot
# pass them. Unset means the default shown.
# BROWSER_ARTIFACT_QUOTA_BYTES_PER_USER=104857600
# BROWSER_ARTIFACT_QUOTA_BYTES_PER_ORGANIZATION=524288000
# BROWSER_ARTIFACT_MAX_COUNT_PER_USER=200
# BROWSER_ARTIFACT_MAX_COUNT_PER_ORGANIZATION=1000
# The directory must be empty or already a JARVIS artifact store: the store
# refuses a non-empty directory without its marker file, so it never adopts or
# deletes files it did not write. Upgrading from before Phase 19.4: point
# BROWSER_DOWNLOAD_DIR at a new, empty directory (the old files were only
# reachable by the process that wrote them, and never after a restart).
#
# -----------------------------------------------------------------------------
# Phase 19.2 — the isolated browser service (optional, off by default)
# -----------------------------------------------------------------------------
# When BROWSER_SERVICE_URL is set, the browser tools talk to a separate
# browser-service container instead of a Chromium in the API process. Everything
# else about the tools — the opt-in, the reads/writes split, the approvals, the
# grants — is unchanged: the service performs typed actions, the API still
# authorizes every one of them.
#
# BROWSER_ENABLED must still be "true"; a URL alone registers nothing. A URL
# with an unusable configuration registers NO browser tools — there is no
# fall back to an in-process Chromium, because that would silently undo the
# isolation the operator asked for.
#
# These four must match the browser service's own values. BROWSER_SERVICE_SHARED_SECRET
# is a signing key, not a password: at least 32 characters, generated per
# deployment, never committed and never logged.
# BROWSER_SERVICE_URL="https://browser-service:3200"
# BROWSER_SERVICE_KEY_ID="jarvis-api"
# BROWSER_SERVICE_SHARED_SECRET=""
# BROWSER_SERVICE_PEER_IDENTITY="jarvis-api"
# BROWSER_SERVICE_TIMEOUT_MS=30000
# The API's client certificate. REQUIRED: the service accepts mutual TLS only,
# so the URL must be https and both paths must be set, or no browser tool is
# registered. The pair is what proves the caller's identity at the socket.
# BROWSER_SERVICE_CLIENT_CERT_PATH=""
# BROWSER_SERVICE_CLIENT_KEY_PATH=""
# The CA that signed the service's certificate.
# BROWSER_SERVICE_CA_PATH=""
#
# The service side. The browser-service container has NO env_file: compose
# passes it exactly these names (and BROWSER_NAVIGATION_TIMEOUT_MS,
# BROWSER_DOMAIN_ALLOWLIST, BROWSER_MAX_DOWNLOAD_BYTES and the
# BROWSER_ARTIFACT_* variables), read from here at `docker compose` time.
# Nothing else in this file reaches it. KEY_ID, SHARED_SECRET and PEER_IDENTITY above
# are shared by both sides.
# The service's own certificate and key, and the CA its clients' certificates
# must chain to. All three are required; the service will not start without
# them. Rotation and revocation are manual (docs/phases/phase-19.md, §14.7).
# BROWSER_SERVICE_TLS_CERT_PATH=""
# BROWSER_SERVICE_TLS_KEY_PATH=""
# BROWSER_SERVICE_TLS_CA_PATH=""
# Chromium stays off unless this is exactly "true".
# BROWSER_SERVICE_CHROMIUM_ENABLED="false"
# Optional: hides /healthz behind a token on both listeners.
# BROWSER_SERVICE_HEALTH_TOKEN=""
# Optional limits; unset means the service's default. The session TTL, the
# session counts and the body size cannot be raised past the protocol's
# ceiling. The request timeout and the clock skew are defaults, not ceilings:
#   BROWSER_SERVICE_REQUEST_TIMEOUT_MS: default 30000 (30 s); configurable
#     from 1000 to 120000 (1 to 120 s).
#   BROWSER_SERVICE_CLOCK_SKEW_MS: default 60000 (60 s); configurable from
#     1000 to 300000 (1 to 300 s).
# BROWSER_SERVICE_SESSION_TTL_MS=60000
# BROWSER_SERVICE_MAX_SESSIONS=2
# BROWSER_SERVICE_MAX_SESSIONS_PER_ORGANIZATION=2
# BROWSER_SERVICE_REQUEST_TIMEOUT_MS=30000
# BROWSER_SERVICE_CLOCK_SKEW_MS=60000
# BROWSER_SERVICE_MAX_BODY_BYTES=65536
# Phase 19.4 — the service's artifact store. With
# BROWSER_SERVICE_CHROMIUM_ENABLED="true" it refuses to start unless
# BROWSER_SERVICE_DOWNLOAD_DIR is an absolute path AND
# BROWSER_ARTIFACT_RETENTION_HOURS (above) is set. docker-compose.yml sets the
# directory to /var/lib/jarvis-browser/artifacts on the named volume
# jarvis-browser-artifacts; it is not read from this file there. Expired and
# half-written artifacts are swept at start-up and then on this interval
# (10000 to 86400000 ms; default 600000).
# BROWSER_SERVICE_DOWNLOAD_DIR="/var/lib/jarvis-browser/artifacts"
# BROWSER_ARTIFACT_SWEEP_INTERVAL_MS=600000
# There is no plain-HTTP mode and no forwarded-identity mode: the service
# refuses to start if BROWSER_SERVICE_REQUIRE_MTLS is set to anything but
# "true" or BROWSER_SERVICE_TRUST_FORWARDED_PEER_IDENTITY to anything but
# "false". Do not set either.
#
# -----------------------------------------------------------------------------
# Phase 19.3 — the browser's egress proxy (browser-egress, same compose profile)
# -----------------------------------------------------------------------------
# Every connection Chromium makes goes through this proxy, and Chromium can
# resolve no other name. With BROWSER_SERVICE_CHROMIUM_ENABLED="true" the
# browser service refuses to start without it. docker-compose.yml sets it to
# http://browser-egress:3128; it is not read from this file there.
# BROWSER_SERVICE_EGRESS_PROXY_URL="http://browser-egress:3128"
#
# The proxy refuses private, loopback, link-local, CGNAT, reserved, multicast,
# documentation and cloud-metadata addresses (IPv4 and IPv6, in every spelling,
# including IPv4-mapped, NAT64, 6to4 and Teredo forms), single-label and
# special-use names (.internal, .local, .localhost, ...), and any name that
# resolves to one of those. No setting below can open them.
# Ports a destination may use. Default: 80,443.
# BROWSER_EGRESS_ALLOWED_PORTS="80,443"
# Optional: only these public domains and their subdomains. Empty: any public
# host. Addresses, single-label and special-use names are refused here.
# BROWSER_EGRESS_DOMAIN_ALLOWLIST=""
# Limits. Unset means the default shown.
# BROWSER_EGRESS_DNS_TIMEOUT_MS=5000
# BROWSER_EGRESS_CONNECT_TIMEOUT_MS=10000
# BROWSER_EGRESS_IDLE_TIMEOUT_MS=120000
# BROWSER_EGRESS_MAX_CONNECTIONS=256

# -----------------------------------------------------------------------------
# MCP tool servers (optional)
# -----------------------------------------------------------------------------
# Off unless JARVIS_MCP_ENABLED=true. Only servers in the reviewed manifest
# (packages/core/src/mcp-manifest.ts) can ever run — none is reviewed yet — and
# only their read-only tools, for OWNER and ADMIN users, through the general
# assistant. A server's secrets come from JARVIS_MCP_<SERVER ID>_<NAME>
# variables named in its manifest entry; nothing else is passed to it.
# JARVIS_MCP_ENABLED="false"

# -----------------------------------------------------------------------------
# Anthropic Claude adapter — NOT WIRED
# -----------------------------------------------------------------------------
# packages/ai-anthropic exists but nothing imports it, so these currently have
# no effect. Listed so the names are not reinvented when it is wired in.
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# CLAUDE_DEFAULT_MODEL=""
# CLAUDE_TIMEOUT_MS=30000
# CLAUDE_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Web app — set in apps/web/.env.local, not here
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
