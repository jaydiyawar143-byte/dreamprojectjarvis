{
  "PairRequest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "string",
        "const": "jarvis-desktop/1"
      },
      "pairingCode": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "publicKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9+/]+={0,2}$"
      },
      "deviceName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "agentVersion": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$"
      },
      "windowsBuild": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      },
      "architecture": {
        "type": "string",
        "enum": [
          "x64",
          "arm64",
          "x86"
        ]
      }
    },
    "required": [
      "version",
      "pairingCode",
      "publicKey",
      "deviceName",
      "agentVersion",
      "windowsBuild",
      "architecture"
    ],
    "additionalProperties": false
  },
