<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Phase 19.6: the agent's platform-neutral tests. They hold the C# protocol
    to the TypeScript one through apps/desktop-agent/contract, and exercise
    verification, consent, execution and the signed client with fakes — no
    Windows API, no network, no input sent anywhere.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names read as sentences; the analyzers' naming rules do not apply. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Jarvis.DesktopAgent.Core\Jarvis.DesktopAgent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\contract\*.json" Link="contract\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
