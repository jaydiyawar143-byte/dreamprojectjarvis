    classDef orange fill:#c77d1e,color:#fff,stroke:#8a510f
    classDef blue fill:#2563eb,color:#fff,stroke:#163d91
    classDef grey fill:#374151,color:#fff,stroke:#1f2937

    class R6,R5,R7,R8,R9,Chat green
    class Propose,Execute,MockLife purple
    class OWork,X_OW_X,X_D_X,X_H_X red
