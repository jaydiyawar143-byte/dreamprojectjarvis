generator client {
  provider = "prisma-client-js"
  // "native" keeps the host build working (Windows, macOS, glibc Linux).
  // The musl target is what the Alpine containers need: a client generated
  // only for the host has no query engine the container can load, and the
  // failure surfaces at runtime as a missing-binary error rather than at build.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AgentStatus {
  IDLE
  INITIALIZING
  READY
  PROCESSING
  ERROR
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CONSUMED
  REJECTED
  EXPIRED
}

enum AuditResult {
  SUCCESS
  FAILURE
  REJECTED
  PENDING
}

enum ToolExecutionStatus {
  PENDING
  APPROVED
  EXECUTING
  SUCCEEDED
  FAILED
  UNKNOWN
  RECONCILING
  SAFE_TO_RETRY
  CANCELLED
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  PROJECT
  DECISION
  WORKFLOW
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  role        Role      @default(MEMBER)
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  conversations Conversation[]
  memories      Memory[]
  approvals     Approval[]
  auditLogs     AuditLog[]
  settings      UserSetting[]
  refreshTokens RefreshToken[]
  executions    ToolExecution[]
  marketingAccounts MarketingAccount[]
  knowledgeDocuments KnowledgeDocument[]
  googleConnections GoogleConnection[]
  oauthStates       OAuthState[]
  whatsappAccounts  WhatsAppAccount[]
  whatsappMessages  WhatsAppMessage[]
  n8nWorkflows      N8nWorkflow[]
  n8nExecutions     N8nExecution[]
  tasks             Task[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  userId    String
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Agent {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  category    String
  status      AgentStatus @default(IDLE)
  config      Json?
  tools       Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  conversations Conversation[]
}

model Memory {
  id                   String                       @id @default(cuid())
  userId               String
  type                 MemoryType                   @default(FACT)
  content              String
  summary              String?
  embedding            Unsupported("vector(1536)")?
  importance           Float                        @default(0.5)
  confidence           Float                        @default(0.5)
  accessCount          Int                          @default(0)
  lastAccessedAt       DateTime?
  metadata             Json?
  sourceType           String?
  sourceConversationId String?
  sourceMessageId      String?
  createdAt            DateTime                     @default(now())
  // @default(now()) mirrors the migration-created DB default
  // (DEFAULT CURRENT_TIMESTAMP); @updatedAt keeps client-side freshness.
  updatedAt            DateTime                     @default(now()) @updatedAt
  expiresAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, createdAt])
}

model KnowledgeDocument {
  id           String   @id @default(cuid())
  userId       String
  title        String
  documentType String?
  mimeType     String?
  content      String
  source       String?
  status       String   @default("UPLOADED")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([userId])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  chunkIndex Int
  metadata   Json?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Approval {
  id             String         @id @default(cuid())
  userId         String
  agentId        String?
  conversationId String?
  toolId         String
  action         String
  params         Json
  paramsHash     String?
  riskLevel      String?
  status         ApprovalStatus @default(PENDING)
  expiresAt      DateTime
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([conversationId, status])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  agentId    String?
  toolId     String?
  action     String
  parameters Json?
  result     AuditResult
  traceId    String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  // Sprint 9.5 — the rate limiter counts a user's rows inside a time window on
  // every approval and voice call. Its source comment already claimed this
  // index existed; it did not, so each check fell back to the single-column
  // userId index and filtered the window in Postgres.
  @@index([userId, createdAt])
}

model Integration {
  id        String   @id @default(cuid())
  name      String
  provider  String
  config    Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

// Sprint 5.2 — Google OAuth connection, one per (user, Google account).
//
// Token columns hold AES-256-GCM envelopes produced by EncryptionService, NOT
// plaintext. encKeyVersion mirrors the envelope prefix so a key rotation can
// find rows still on a retired key without decrypting every one of them.
//
// The deliberately-unused `Integration` model above is NOT used for this: it is
// global rather than per-user, has no User relation, and its `config Json?`
// invites dumping raw token blobs.
model GoogleConnection {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  googleAccountEmail   String    @map("google_account_email")
  // Scopes actually GRANTED by the consent screen, which can be narrower than
  // those requested. Authorization decisions must read this, never the request.
  scopes               String[]
  accessTokenEnc       String    @map("access_token_enc")
  refreshTokenEnc      String    @map("refresh_token_enc")
  encKeyVersion        Int       @default(1) @map("enc_key_version")
  accessTokenExpiresAt DateTime  @map("access_token_expires_at")
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleAccountEmail])
  @@index([userId])
  @@map("GoogleConnection")
}

// Sprint 5.3 — claims a WhatsApp business phone number for a JARVIS user.
//
// The webhook is an UNAUTHENTICATED endpoint: Meta calls it, not a logged-in
// user. This table is what turns an inbound payload into an owned row — a
// phone_number_id with no claim here is rejected rather than attributed to a
// guessed user. It is therefore the tenant-isolation boundary for inbound.
model WhatsAppAccount {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  phoneNumberId String   @unique @map("phone_number_id")
  displayName   String?  @map("display_name")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("WhatsAppAccount")
}

// Sprint 5.3 — durable message log for both directions.
//
// provider_message_id is UNIQUE, and that constraint IS the replay defence:
// Meta redelivers a webhook until it gets a 200, so the same wamid arrives
// repeatedly. Letting the database reject the second insert makes duplicate
// suppression atomic and crash-safe, rather than depending on in-process state.
model WhatsAppMessage {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  providerMessageId String   @unique @map("provider_message_id")
  waId              String   @map("wa_id")
  phoneNumberId     String   @map("phone_number_id")
  direction         String
  type              String
  body              String?
  status            String?
  providerTimestamp DateTime @map("provider_timestamp")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, waId])
  @@map("WhatsAppMessage")
}

// Sprint 5.4 — workflows a user is permitted to trigger.
//
// This is an ALLOW-LIST, and it is the tenant-isolation boundary for outbound.
// A caller passes a JARVIS workflow id, never an n8n URL or path, so no request
// can aim the trigger at an arbitrary endpoint (an SSRF-shaped risk when a
// self-hosted n8n sits inside the same network). The webhook path is resolved
// server-side from this table.
model N8nWorkflow {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  // n8n webhook path segment only — never a full URL.
  webhookPath String   @map("webhook_path")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions N8nExecution[]

  @@unique([userId, webhookPath])
  @@index([userId])
  @@map("N8nWorkflow")
}

// Sprint 5.4 — durable audit trail and idempotency record for workflow runs.
//
// Two independent unique constraints, each guarding a different direction:
//
//   idempotency_key  — OUTBOUND. A retried trigger converges on the existing
//                      row instead of starting a second workflow run.
//   callback_event_id — INBOUND. A redelivered result is applied at most once.
//
// status TRIGGERED is deliberately not "failed": the workflow may have had real
// side effects even when no callback arrives, so it is never auto-retried. Same
// reasoning as UNKNOWN in the Phase 10 ToolExecution journal.
model N8nExecution {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  workflowId        String    @map("workflow_id")
  idempotencyKey    String    @unique @map("idempotency_key")
  remoteExecutionId String?   @map("remote_execution_id")
  status            String    @default("TRIGGERED")
  // SHA-256 of the request payload: proves what was sent without storing it.
  payloadHash       String    @map("payload_hash")
  callbackEventId   String?   @unique @map("callback_event_id")
  resultSummary     String?   @map("result_summary")
  errorCode         String?   @map("error_code")
  traceId           String    @map("trace_id")
  triggeredAt       DateTime  @default(now()) @map("triggered_at")
  completedAt       DateTime? @map("completed_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow N8nWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId, triggeredAt])
  @@index([workflowId])
  @@map("N8nExecution")
}

// Sprint 5.2 — short-lived OAuth authorization-code state.
//
// Carries the CSRF `state` and the PKCE code_verifier. Rows are single-use:
// the callback deletes the row as it reads it, so a replayed authorization code
// finds nothing and is rejected. The verifier is a one-time secret with a
// ~10 minute lifetime, so it is stored as-is rather than encrypted.
model OAuthState {
  state        String   @id
  userId       String   @map("user_id")
  provider     String   @default("google")
  codeVerifier String   @map("code_verifier")
  redirectUri  String   @map("redirect_uri")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("OAuthState")
}

// Phase 10.1 — Durable execution journal.
// Authoritative record of external side-effecting tool executions.
// Idempotency is enforced by the database: the unique constraint on
// (userId, toolId, idempotencyKey) guarantees concurrent attempts converge
// on a single execution row. UNKNOWN means an external write may have
// executed with uncertain outcome and must never be auto-retried.
model ToolExecution {
  executionId        String              @id @default(cuid()) @map("execution_id")
  userId             String              @map("user_id")
  toolId             String              @map("tool_id")
  idempotencyKey     String              @map("idempotency_key")
  paramsHash         String?             @map("params_hash")
  status             ToolExecutionStatus @default(PENDING)
  provider           String?
  externalResourceId String?             @map("external_resource_id")
  errorCode          String?             @map("error_code")
  errorMessage       String?             @map("error_message")
  traceId            String?             @map("trace_id")
  ownerId            String?             @map("owner_id")
  leaseUntil         DateTime?           @map("lease_until")
  heartbeatAt        DateTime?           @map("heartbeat_at")
  approvalId         String?             @map("approval_id")
  // NOT NULL DEFAULT 0 in the database (phase105 migration); required here to
  // keep the datamodel in lockstep with deployed migrations (zero-drift rule).
  reconciliationAttempts      Int        @default(0) @map("reconciliation_attempts")
  lastReconciliationAt        DateTime?  @map("last_reconciliation_at")
  lastReconciliationResult    String?    @map("last_reconciliation_result")
  createdAt          DateTime            @default(now()) @map("created_at")
  startedAt          DateTime?           @map("started_at")
  completedAt        DateTime?           @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId, idempotencyKey], map: "tool_executions_idempotency_unique")
  @@index([userId], map: "tool_executions_user_idx")
  @@index([status], map: "tool_executions_status_idx")
  @@index([idempotencyKey], map: "tool_executions_idem_key_idx")
  @@index([traceId], map: "tool_executions_trace_idx")
  @@index([createdAt], map: "tool_executions_created_at_idx")
  @@index([status, leaseUntil], map: "tool_executions_stale_idx")
  @@map("ToolExecution")
}

// ---------------------------------------------------------------------------
// Phase 11 — Marketing Intelligence Data Models
// ---------------------------------------------------------------------------

model MarketingAccount {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  accountId     String   @unique @map("account_id") // e.g. "act_123456789"
  name          String
  currency      String   @default("USD")
  timezoneName  String   @default("UTC") @map("timezone_name")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots       MetricSnapshot[]
  recommendations PerformanceRecommendation[]
  outcomes        DecisionRecord[]
  outcomeRecords  OutcomeRecord[]

  @@index([userId])
  @@map("MarketingAccount")
}

// Phase 11.7A enums — Outcome Measurement Foundation
enum OutcomeEnum {
  POSITIVE
  NEGATIVE
  NEUTRAL
  INCONCLUSIVE
  NOT_MEASURABLE
  FAILED_ACTION
}

enum MeasurementState {
  SCHEDULED
  COLLECTING
  WAITING_FOR_DATA
  WAITING_FOR_ATTRIBUTION
  READY
  FINALIZED
}

enum PerformanceLevel {
  ACCOUNT
  CAMPAIGN
  AD_SET
  AD
}

model MetricSnapshot {
  id             String           @id @default(cuid())
  accountId      String           @map("account_id")
  level          PerformanceLevel
  entityId       String           @map("entity_id")
  entityName     String?          @map("entity_name")
  dateStart      DateTime         @map("date_start")
  dateStop       DateTime         @map("date_stop")
  periodType     String           @map("period_type")
  
  spend          Decimal          @db.Decimal(12, 2)
  impressions    BigInt
  clicks         BigInt
  reach          BigInt           @default(0)
  conversions    Decimal          @default(0) @db.Decimal(12, 2)
  revenue        Decimal          @default(0) @db.Decimal(12, 2)
  
  ctr            Float?
  cpc            Decimal?         @db.Decimal(10, 4)
  cpm            Decimal?         @db.Decimal(10, 4)
  cpa            Decimal?         @db.Decimal(10, 4)
  roas           Float?
  cvr            Float?
  frequency      Float?

  rawPayload     Json?            @map("raw_payload")
  createdAt      DateTime         @default(now()) @map("created_at")

  account MarketingAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@unique([accountId, level, entityId, dateStart, dateStop, periodType], map: "metric_snapshot_unique_key")
  @@index([accountId, level, entityId, dateStart])
  @@index([dateStart, dateStop])
  @@map("MetricSnapshot")
}

// Phase 11.5 lifecycle: PROPOSED -> APPROVED -> EXECUTING -> EXECUTED, with
// REJECTED / EXPIRED / STALE / FAILED terminal states. PENDING_APPROVAL is a
// legacy value retained so existing databases keep migrating cleanly.
enum RecommendationStatus {
  PROPOSED
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  EXECUTED
  REJECTED
  EXPIRED
  STALE
  FAILED
}

enum OptimizationActionType {
  PAUSE_CAMPAIGN
  RESUME_CAMPAIGN
  PAUSE_ADSET
  RESUME_ADSET
  PAUSE_AD
  RESUME_AD
  INCREASE_BUDGET
  DECREASE_BUDGET
}

model PerformanceRecommendation {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  accountId         String                 @map("account_id")
  targetLevel       PerformanceLevel       @map("target_level")
  targetId          String                 @map("target_id")
  actionType        OptimizationActionType @map("action_type")
  status            RecommendationStatus   @default(PENDING_APPROVAL)

  reason            String
  evidence          Json
  expectedImpact    String                 @map("expected_impact")
  confidence        Float
  riskLevel         String                 @map("risk_level")
  proposedChange    Json                   @map("proposed_change")
  paramsHash        String                 @map("params_hash")

  // --- Phase 11.5 evidence/state binding --------------------------------
  diagnosisId       String?                @map("diagnosis_id")
  diagnosisCategory String?                @map("diagnosis_category")
  anomalyIds        Json                   @default("[]") @map("anomaly_ids")
  currentState      Json?                  @map("current_state")
  proposedState     Json?                  @map("proposed_state")
  preconditions     Json                   @default("[]")
  evidenceHash      String?                @map("evidence_hash")
  stateHash         String?                @map("state_hash")
  identityHash      String?                @map("identity_hash")
  requiresApproval  Boolean                @default(true) @map("requires_approval")
  staleReasons      Json?                  @map("stale_reasons")
  priority          String                 @default("MEDIUM") @map("priority")
  historicalEvidenceIds Json               @default("[]") @map("historical_evidence_ids")
  confidenceExplanation Json?                @map("confidence_explanation")
  approvalId        String?                @map("approval_id")
  executionId       String?                @map("execution_id")

  expiresAt         DateTime               @map("expires_at")
  approvedAt        DateTime?              @map("approved_at")
  rejectedAt        DateTime?              @map("rejected_at")
  executedAt        DateTime?              @map("executed_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  account MarketingAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  outcome DecisionRecord?
  outcomeRecord OutcomeRecord?

  @@index([userId, status])
  @@index([accountId, targetId])
  @@index([accountId, targetId, status])
  @@index([paramsHash])
  @@map("PerformanceRecommendation")
}

model DecisionRecord {
  id                 String   @id @default(cuid())
  recommendationId   String   @unique @map("recommendation_id")
  accountId          String   @map("account_id")
  executionId        String   @map("execution_id")
  
  baselineMetrics    Json     @map("baseline_metrics")
  postMetrics        Json?    @map("post_metrics")
  measuredAt         DateTime? @map("measured_at")
  
  outcomeRating      String?  @map("outcome_rating")
  kpiDeltaPercent    Float?   @map("kpi_delta_percent")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  recommendation PerformanceRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  account MarketingAccount                 @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
  @@map("DecisionRecord")
}

// ---------------------------------------------------------------------------
// Phase 11.7A — OutcomeRecord
// ---------------------------------------------------------------------------
// Authoritative, immutable-once-finalized measurement of whether an approved
// marketing action produced its intended outcome.
//
// Rules enforced at the repository layer:
//   - baselineSnapshot is written ONCE at creation and NEVER updated.
//   - isFinal = true → no further updates are allowed (idempotent finalize).
//   - Unique per recommendationId → one outcome per recommendation.
//   - Account + userId isolation enforced on every read/write.
// ---------------------------------------------------------------------------
model OutcomeRecord {
  // --- Core identifiers ---
  outcomeId          String            @id @default(cuid())   @map("outcome_id")
  recommendationId   String            @unique                 @map("recommendation_id")
  executionId        String                                    @map("execution_id")
  userId             String                                    @map("user_id")
  accountId          String                                    @map("account_id")
  diagnosisCategory  String?                                   @map("diagnosis_category")

  // --- Entity context ---
  entityType         PerformanceLevel                          @map("entity_type")
  entityId           String                                    @map("entity_id")
  actionType         OptimizationActionType                    @map("action_type")
  objective          String?                                   @map("objective")
  primaryMetric      String                                    @map("primary_metric")

  // --- Immutable baseline (written once at create, NEVER updated) ---
  baselineSnapshot   Json                                      @map("baseline_snapshot")

  // --- Current measurement (updated as data arrives, frozen at FINALIZED) ---
  measurementKpis    Json?                                     @map("measurement_kpis")
  comparison         Json?                                     @map("comparison")

  // --- Outcome verdict (null until FINALIZED) ---
  outcomeEnum        OutcomeEnum?                              @map("outcome_enum")
  confidence         Float?                                    @map("confidence")
  dataQuality        String?                                   @map("data_quality")

  // --- Attribution & confounders ---
  attributionStatus  String                                    @map("attribution_status")
  confounders        Json                                      @default("[]") @map("confounders")
  measurementWindow  Json                                      @map("measurement_window")

  // --- Lifecycle ---
  measurementState   MeasurementState  @default(SCHEDULED) @map("measurement_state")
  /// Once isFinal = true, all columns are frozen. Repository MUST enforce this.
  isFinal            Boolean           @default(false)         @map("is_final")
  measuredAt         DateTime?                                 @map("measured_at")
  createdAt          DateTime          @default(now())          @map("created_at")
  updatedAt          DateTime          @updatedAt               @map("updated_at")

  recommendation PerformanceRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  account        MarketingAccount           @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  revisions      OutcomeRevision[]

  @@index([userId, accountId], map: "outcome_records_user_account_idx")
  @@index([userId, accountId, diagnosisCategory], map: "outcome_records_user_account_category_idx")
  @@index([accountId, measurementState], map: "outcome_records_account_state_idx")
  @@index([recommendationId], map: "outcome_records_recommendation_idx")
  @@index([createdAt], map: "outcome_records_created_at_idx")
  @@map("OutcomeRecord")
}

model OutcomeRevision {
  id                 String            @id @default(cuid())   @map("id")
  outcomeId          String                                    @map("outcome_id")
  revisionNumber     Int                                       @map("revision_number")
  outcomeEnum        OutcomeEnum                               @map("outcome_enum")
  confidence         Float                                     @map("confidence")
  dataQuality        String                                    @map("data_quality")
  attributionStatus  String                                    @map("attribution_status")
  confounders        Json                                      @map("confounders")
  measurementKpis    Json                                      @map("measurement_kpis")
  comparison         Json                                      @map("comparison")
  measuredAt         DateTime                                  @map("measured_at")
  createdAt          DateTime          @default(now())          @map("created_at")

  outcomeRecord      OutcomeRecord     @relation(fields: [outcomeId], references: [outcomeId], onDelete: Cascade)

  @@unique([outcomeId, revisionNumber], map: "outcome_revisions_unique_idx")
  @@index([outcomeId], map: "outcome_revisions_outcome_idx")
  @@map("OutcomeRevision")
}


// ---------------------------------------------------------------------------
// V3 — Command Center tasks and reminders.
//
// Persisted server-side because a reminder that lives in a browser tab is not a
// reminder. This is also what lets JARVIS create one from a spoken request and
// have it still be there tomorrow.
//
// Scoped by userId with a compound index on (userId, dueAt): every query this
// feature makes is "my tasks, ordered by when they are due", and that index is
// what keeps it a range scan rather than a full table scan per dashboard load.
//
// `completedAt` is a timestamp rather than a boolean so "when did I finish
// this" is answerable, and so completion is idempotent.
// ---------------------------------------------------------------------------
model Task {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  title       String
  description String?
  /// Null means "someday": a task with no deadline, which is never overdue.
  dueAt       DateTime? @map("due_at")
  priority    String    @default("NORMAL")
  completedAt DateTime? @map("completed_at")
  /// Set once a reminder has been surfaced, so it is not raised twice.
  remindedAt  DateTime? @map("reminded_at")
  /// Which agent or flow created it, for the audit trail. Null when manual.
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, completedAt])
  @@map("Task")
}

// ---------------------------------------------------------------------------
// Google Maps monthly usage guard.
//
// A JARVIS-side cost ceiling. It is NOT a replacement for Google's own billing
// controls — a Cloud budget alert and a quota cap still belong in the console.
// What this adds is a limit JARVIS itself enforces before a request leaves the
// process, so a runaway loop is stopped by our code rather than by a bill.
//
// ONE ROW PER (period, user, service).
//
//   - `period` is the calendar month in UTC, "2026-09". The monthly reset is
//     therefore IMPLICIT: a new month simply writes to new rows. There is no
//     scheduled reset job, so there is no reset job that can fail to run and
//     silently carry a full counter into a new month.
//
//   - `userId` gives per-user attribution, which is what "per-tenant usage"
//     means in this codebase — there is no separate tenant model, the user IS
//     the isolation boundary everywhere else.
//
//   - `service` splits Places / Geocoding / Routes / Autocomplete, because they
//     are priced differently and an operator needs to see which one is running.
//
// Rows are never deleted on rollover; the history is the usage report.
// ---------------------------------------------------------------------------
model MapsUsage {
  id        String   @id @default(cuid())
  /// Calendar month in UTC, formatted "YYYY-MM".
  period    String
  userId    String   @map("user_id")
  /// "places" | "autocomplete" | "place_details" | "geocoding" | "routes"
  service   String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([period, userId, service], map: "maps_usage_period_user_service_unique")
  @@index([period], map: "maps_usage_period_idx")
  @@index([period, userId], map: "maps_usage_period_user_idx")
  @@map("MapsUsage")
}
