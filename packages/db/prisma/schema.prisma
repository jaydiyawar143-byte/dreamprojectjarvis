generator client {
  provider = "prisma-client-js"
  // "native" keeps the host build working (Windows, macOS, glibc Linux).
  // The musl target is what the Alpine containers need: a client generated
  // only for the host has no query engine the container can load, and the
  // failure surfaces at runtime as a missing-binary error rather than at build.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AgentStatus {
  IDLE
  INITIALIZING
  READY
  PROCESSING
  ERROR
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CONSUMED
  REJECTED
  EXPIRED
}

enum AuditResult {
  SUCCESS
  FAILURE
  REJECTED
  PENDING
}

enum ToolExecutionStatus {
  PENDING
  APPROVED
  EXECUTING
  SUCCEEDED
  FAILED
  UNKNOWN
  RECONCILING
  SAFE_TO_RETRY
  CANCELLED
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  PROJECT
  DECISION
  WORKFLOW
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  role        Role      @default(MEMBER)
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  conversations Conversation[]
  memories      Memory[]
  approvals     Approval[] @relation("ApprovalRequester")
  // Phase 17 — approvals this account decided for someone else.
  decidedApprovals Approval[] @relation("ApprovalDecider")
  // Phase 18 — library synchronizations this account asked for.
  automationLibraryRuns AutomationLibrarySyncRun[] @relation("AutomationLibrarySyncRequester")
  // Phase 18.2 — continue-until-complete chains this account started.
  automationLibraryChains AutomationLibrarySyncChain[] @relation("AutomationLibraryChainRequester")
  // Phase 18.4 — workflow drafts and draft versions this account wrote.
  automationDrafts        AutomationDraft[]        @relation("AutomationDraftAuthor")
  automationDraftVersions AutomationDraftVersion[] @relation("AutomationDraftVersionAuthor")
  auditLogs     AuditLog[]
  settings      UserSetting[]
  refreshTokens RefreshToken[]
  executions    ToolExecution[]
  marketingAccounts MarketingAccount[]
  knowledgeDocuments KnowledgeDocument[]
  googleConnections GoogleConnection[]
  oauthStates       OAuthState[]
  whatsappAccounts  WhatsAppAccount[]
  whatsappMessages  WhatsAppMessage[]
  n8nWorkflows      N8nWorkflow[]
  n8nExecutions     N8nExecution[]
  tasks             Task[]
  confirmations     Confirmation[]
  projects          Project[]
  // Phase 15 — the marketing workspace.
  marketingCampaigns MarketingCampaign[]
  contentItems       ContentItem[]
  marketingReports   MarketingReport[]
  marketingResearch  MarketingResearch[]
  // Phase 17 — the tenants (Organizations) this account is a member of. A
  // relation only: no column, and `role` above keeps its meaning.
  tenantMemberships TenantMembership[]
  // Phase 19.6 — the Windows desktop agent: codes this account issued,
  // devices paired to it, and devices it revoked.
  desktopPairingCodes   DesktopPairingCode[]
  desktopDevices        DesktopDevice[]      @relation("DesktopDeviceOwner")
  revokedDesktopDevices DesktopDevice[]      @relation("DesktopDeviceRevoker")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  userId    String
  agentId   String?
  // Phase 14 — the project this conversation belongs to; null is personal.
  // Set once, at creation, from one of the user's OWN projects.
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages Message[]
}

// Phase 14 — the smallest thing that can give a memory a scope: a name, owned
// by one user. Not a project-management system: no members, tasks or settings.
//
// `@@unique([id, userId])` exists for one reason: `Memory` references a
// project by BOTH columns, so the database itself refuses a memory that names
// a project its own user does not own.
model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories      Memory[]
  conversations Conversation[]
  // Phase 15 — the marketing rows scoped to this project. Each references it
  // by (id, userId), exactly as `Memory` does.
  marketingCampaigns MarketingCampaign[]
  contentItems       ContentItem[]
  marketingReports   MarketingReport[]
  marketingResearch  MarketingResearch[]

  @@unique([userId, name])
  @@unique([id, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Agent {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  category    String
  status      AgentStatus @default(IDLE)
  config      Json?
  tools       Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  conversations Conversation[]
}

model Memory {
  id                   String                       @id @default(cuid())
  userId               String
  type                 MemoryType                   @default(FACT)
  content              String
  summary              String?
  embedding            Unsupported("vector(1536)")?
  importance           Float                        @default(0.5)
  confidence           Float                        @default(0.5)
  accessCount          Int                          @default(0)
  lastAccessedAt       DateTime?
  metadata             Json?
  sourceType           String?
  sourceConversationId String?
  sourceMessageId      String?
  createdAt            DateTime                     @default(now())
  // @default(now()) mirrors the migration-created DB default
  // (DEFAULT CURRENT_TIMESTAMP); @updatedAt keeps client-side freshness.
  updatedAt            DateTime                     @default(now()) @updatedAt
  expiresAt            DateTime?
  // Phase 14 — null: a PERSONAL memory. Otherwise the one project, of the same
  // user, that this memory belongs to. Deleting a project deletes its
  // memories; it never turns them into personal ones.
  projectId            String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([userId, projectId])
  // The retention sweep finds expired rows across users by this.
  @@index([expiresAt])
}

model KnowledgeDocument {
  id           String   @id @default(cuid())
  userId       String
  title        String
  documentType String?
  mimeType     String?
  content      String
  source       String?
  status       String   @default("UPLOADED")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([userId])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  chunkIndex Int
  metadata   Json?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Approval {
  id             String         @id @default(cuid())
  userId         String
  agentId        String?
  conversationId String?
  toolId         String
  action         String
  params         Json
  paramsHash     String?
  riskLevel      String?
  status         ApprovalStatus @default(PENDING)
  expiresAt      DateTime
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  // Phase 17 multi-business hardening. Set by the approval store ALONE, from
  // the owner record, when the approval is for a write through a connection
  // the deployment configures for everyone: the Organization the write acts
  // for. Such an approval is decided by one of that Organization's owners or
  // admins who is not the requester, and consumed only while that still holds.
  // Never written from a request. `Restrict`: an Organization with approvals
  // on record is not deleted out from under them.
  tenantId       String?
  /// Who decided it, when someone other than the requester did.
  decidedById    String?

  user      User    @relation("ApprovalRequester", fields: [userId], references: [id])
  decidedBy User?   @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Phase 19.5 — a browser or desktop approval's exact parameters, sealed.
  sealedParams ApprovalSealedParams?

  @@index([conversationId])
  @@index([conversationId, status])
  @@index([tenantId, status])
}

/// Phase 19, Stage 19.5 — the exact parameters of a browser or desktop
/// approval, sealed (AES-256-GCM, by the API's EncryptionService) apart from
/// the approval record, whose `params` hold only the value-free record: what a
/// person typed, selected or submitted, and a URL's path and query, are never
/// stored in the clear. Written with the approval; deleted when it is rejected,
/// consumed or expired, and with it. Nothing reads it but the approval store.
model ApprovalSealedParams {
  approvalId String   @id @map("approval_id")
  /// The sealed JSON of the exact parameters. Opaque; never logged or returned.
  sealed     String
  /// The approval's own expiry: past it, the parameters can never run.
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("ApprovalSealedParams")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  agentId    String?
  toolId     String?
  action     String
  parameters Json?
  result     AuditResult
  traceId    String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  // Sprint 9.5 — the rate limiter counts a user's rows inside a time window on
  // every approval and voice call. Its source comment already claimed this
  // index existed; it did not, so each check fell back to the single-column
  // userId index and filtered the window in Postgres.
  @@index([userId, createdAt])
}

model Integration {
  id        String   @id @default(cuid())
  name      String
  provider  String
  config    Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

// Sprint 5.2 — Google OAuth connection, one per (user, Google account).
//
// Token columns hold AES-256-GCM envelopes produced by EncryptionService, NOT
// plaintext. encKeyVersion mirrors the envelope prefix so a key rotation can
// find rows still on a retired key without decrypting every one of them.
//
// The deliberately-unused `Integration` model above is NOT used for this: it is
// global rather than per-user, has no User relation, and its `config Json?`
// invites dumping raw token blobs.
model GoogleConnection {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  googleAccountEmail   String    @map("google_account_email")
  // Scopes actually GRANTED by the consent screen, which can be narrower than
  // those requested. Authorization decisions must read this, never the request.
  scopes               String[]
  accessTokenEnc       String    @map("access_token_enc")
  refreshTokenEnc      String    @map("refresh_token_enc")
  encKeyVersion        Int       @default(1) @map("enc_key_version")
  accessTokenExpiresAt DateTime  @map("access_token_expires_at")
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleAccountEmail])
  @@index([userId])
  @@map("GoogleConnection")
}

// Sprint 5.3 — claims a WhatsApp business phone number for a JARVIS user.
//
// The webhook is an UNAUTHENTICATED endpoint: Meta calls it, not a logged-in
// user. This table is what turns an inbound payload into an owned row — a
// phone_number_id with no claim here is rejected rather than attributed to a
// guessed user. It is therefore the tenant-isolation boundary for inbound.
model WhatsAppAccount {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  phoneNumberId String   @unique @map("phone_number_id")
  displayName   String?  @map("display_name")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("WhatsAppAccount")
}

// Sprint 5.3 — durable message log for both directions.
//
// provider_message_id is UNIQUE, and that constraint IS the replay defence:
// Meta redelivers a webhook until it gets a 200, so the same wamid arrives
// repeatedly. Letting the database reject the second insert makes duplicate
// suppression atomic and crash-safe, rather than depending on in-process state.
model WhatsAppMessage {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  providerMessageId String   @unique @map("provider_message_id")
  waId              String   @map("wa_id")
  phoneNumberId     String   @map("phone_number_id")
  direction         String
  type              String
  body              String?
  status            String?
  providerTimestamp DateTime @map("provider_timestamp")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, waId])
  @@map("WhatsAppMessage")
}

// Sprint 5.4 — workflows a user is permitted to trigger.
//
// This is an ALLOW-LIST, and it is the tenant-isolation boundary for outbound.
// A caller passes a JARVIS workflow id, never an n8n URL or path, so no request
// can aim the trigger at an arbitrary endpoint (an SSRF-shaped risk when a
// self-hosted n8n sits inside the same network). The webhook path is resolved
// server-side from this table.
model N8nWorkflow {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  // n8n webhook path segment only — never a full URL.
  webhookPath String   @map("webhook_path")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// Phase 18.3B — the Automation Library entry this row was added from
  /// ("<instance key>:<n8n id>"), when it was; null for any other row.
  libraryEntryRef  String? @map("library_entry_ref")
  /// The n8n versionId the approved proposal was bound to.
  libraryVersionId String? @map("library_version_id")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions N8nExecution[]

  @@unique([userId, webhookPath])
  @@index([userId])
  @@index([userId, libraryEntryRef])
  @@map("N8nWorkflow")
}

// Sprint 5.4 — durable audit trail and idempotency record for workflow runs.
//
// Two independent unique constraints, each guarding a different direction:
//
//   idempotency_key  — OUTBOUND. A retried trigger converges on the existing
//                      row instead of starting a second workflow run.
//   callback_event_id — INBOUND. A redelivered result is applied at most once.
//
// status TRIGGERED is deliberately not "failed": the workflow may have had real
// side effects even when no callback arrives, so it is never auto-retried. Same
// reasoning as UNKNOWN in the Phase 10 ToolExecution journal.
model N8nExecution {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  workflowId        String    @map("workflow_id")
  idempotencyKey    String    @unique @map("idempotency_key")
  remoteExecutionId String?   @map("remote_execution_id")
  status            String    @default("TRIGGERED")
  // SHA-256 of the request payload: proves what was sent without storing it.
  payloadHash       String    @map("payload_hash")
  callbackEventId   String?   @unique @map("callback_event_id")
  resultSummary     String?   @map("result_summary")
  errorCode         String?   @map("error_code")
  traceId           String    @map("trace_id")
  triggeredAt       DateTime  @default(now()) @map("triggered_at")
  completedAt       DateTime? @map("completed_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow N8nWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId, triggeredAt])
  @@index([workflowId])
  @@map("N8nExecution")
}

// Sprint 5.2 — short-lived OAuth authorization-code state.
//
// Carries the CSRF `state` and the PKCE code_verifier. Rows are single-use:
// the callback deletes the row as it reads it, so a replayed authorization code
// finds nothing and is rejected. The verifier is a one-time secret with a
// ~10 minute lifetime, so it is stored as-is rather than encrypted.
model OAuthState {
  state        String   @id
  userId       String   @map("user_id")
  provider     String   @default("google")
  codeVerifier String   @map("code_verifier")
  redirectUri  String   @map("redirect_uri")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("OAuthState")
}

// Phase 13 — a pending confirmation of one external write.
//
// The integration command service describes a write, the user confirms it, and
// the confirmation is spent as the write is handed to ToolExecutor. This row is
// that confirmation, shared by every API instance and surviving a restart.
//
//   - `tokenHash` is the SHA-256 of the token. The token is NEVER stored, so a
//     copy of this table cannot confirm anything.
//   - `paramsHash` is the canonical hash of the parameters. No parameter value
//     and no summary is stored: nothing the user typed lives here.
//   - `consumedAt` IS the state. NULL means pending; set means spent. Spending
//     is one conditional UPDATE on that column, which is what lets exactly one
//     of any number of concurrent presenters win. A pending row past
//     `expiresAt` is simply expired — that is derived, never written.
//
// Rows are operational state, not history: the audit log is the record, and a
// row is deleted about a day after it expires.
model Confirmation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id")
  /// Integration id, e.g. "meta".
  integration String
  actionId    String    @map("action_id")
  paramsHash  String    @map("params_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  consumedAt  DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// For the clear-out of rows that expired a day ago.
  @@index([expiresAt])
  @@map("Confirmation")
}

// Phase 10.1 — Durable execution journal.
// Authoritative record of external side-effecting tool executions.
// Idempotency is enforced by the database: the unique constraint on
// (userId, toolId, idempotencyKey) guarantees concurrent attempts converge
// on a single execution row. UNKNOWN means an external write may have
// executed with uncertain outcome and must never be auto-retried.
model ToolExecution {
  executionId        String              @id @default(cuid()) @map("execution_id")
  userId             String              @map("user_id")
  toolId             String              @map("tool_id")
  idempotencyKey     String              @map("idempotency_key")
  paramsHash         String?             @map("params_hash")
  status             ToolExecutionStatus @default(PENDING)
  provider           String?
  externalResourceId String?             @map("external_resource_id")
  errorCode          String?             @map("error_code")
  errorMessage       String?             @map("error_message")
  traceId            String?             @map("trace_id")
  ownerId            String?             @map("owner_id")
  leaseUntil         DateTime?           @map("lease_until")
  heartbeatAt        DateTime?           @map("heartbeat_at")
  approvalId         String?             @map("approval_id")
  // NOT NULL DEFAULT 0 in the database (phase105 migration); required here to
  // keep the datamodel in lockstep with deployed migrations (zero-drift rule).
  reconciliationAttempts      Int        @default(0) @map("reconciliation_attempts")
  lastReconciliationAt        DateTime?  @map("last_reconciliation_at")
  lastReconciliationResult    String?    @map("last_reconciliation_result")
  createdAt          DateTime            @default(now()) @map("created_at")
  startedAt          DateTime?           @map("started_at")
  completedAt        DateTime?           @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId, idempotencyKey], map: "tool_executions_idempotency_unique")
  @@index([userId], map: "tool_executions_user_idx")
  @@index([status], map: "tool_executions_status_idx")
  @@index([idempotencyKey], map: "tool_executions_idem_key_idx")
  @@index([traceId], map: "tool_executions_trace_idx")
  @@index([createdAt], map: "tool_executions_created_at_idx")
  @@index([status, leaseUntil], map: "tool_executions_stale_idx")
  @@map("ToolExecution")
}

// ---------------------------------------------------------------------------
// Phase 11 — Marketing Intelligence Data Models
// ---------------------------------------------------------------------------

model MarketingAccount {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  accountId     String   @unique @map("account_id") // e.g. "act_123456789"
  name          String
  currency      String   @default("USD")
  timezoneName  String   @default("UTC") @map("timezone_name")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots       MetricSnapshot[]
  recommendations PerformanceRecommendation[]
  outcomes        DecisionRecord[]
  outcomeRecords  OutcomeRecord[]

  @@index([userId])
  @@map("MarketingAccount")
}

// Phase 11.7A enums — Outcome Measurement Foundation
enum OutcomeEnum {
  POSITIVE
  NEGATIVE
  NEUTRAL
  INCONCLUSIVE
  NOT_MEASURABLE
  FAILED_ACTION
}

enum MeasurementState {
  SCHEDULED
  COLLECTING
  WAITING_FOR_DATA
  WAITING_FOR_ATTRIBUTION
  READY
  FINALIZED
}

enum PerformanceLevel {
  ACCOUNT
  CAMPAIGN
  AD_SET
  AD
}

model MetricSnapshot {
  id             String           @id @default(cuid())
  accountId      String           @map("account_id")
  level          PerformanceLevel
  entityId       String           @map("entity_id")
  entityName     String?          @map("entity_name")
  dateStart      DateTime         @map("date_start")
  dateStop       DateTime         @map("date_stop")
  periodType     String           @map("period_type")
  
  spend          Decimal          @db.Decimal(12, 2)
  impressions    BigInt
  clicks         BigInt
  reach          BigInt           @default(0)
  conversions    Decimal          @default(0) @db.Decimal(12, 2)
  revenue        Decimal          @default(0) @db.Decimal(12, 2)
  
  ctr            Float?
  cpc            Decimal?         @db.Decimal(10, 4)
  cpm            Decimal?         @db.Decimal(10, 4)
  cpa            Decimal?         @db.Decimal(10, 4)
  roas           Float?
  cvr            Float?
  frequency      Float?

  rawPayload     Json?            @map("raw_payload")
  createdAt      DateTime         @default(now()) @map("created_at")

  account MarketingAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@unique([accountId, level, entityId, dateStart, dateStop, periodType], map: "metric_snapshot_unique_key")
  @@index([accountId, level, entityId, dateStart])
  @@index([dateStart, dateStop])
  @@map("MetricSnapshot")
}

// Phase 11.5 lifecycle: PROPOSED -> APPROVED -> EXECUTING -> EXECUTED, with
// REJECTED / EXPIRED / STALE / FAILED terminal states. PENDING_APPROVAL is a
// legacy value retained so existing databases keep migrating cleanly.
enum RecommendationStatus {
  PROPOSED
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  EXECUTED
  REJECTED
  EXPIRED
  STALE
  FAILED
}

enum OptimizationActionType {
  PAUSE_CAMPAIGN
  RESUME_CAMPAIGN
  PAUSE_ADSET
  RESUME_ADSET
  PAUSE_AD
  RESUME_AD
  INCREASE_BUDGET
  DECREASE_BUDGET
}

model PerformanceRecommendation {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  accountId         String                 @map("account_id")
  targetLevel       PerformanceLevel       @map("target_level")
  targetId          String                 @map("target_id")
  actionType        OptimizationActionType @map("action_type")
  status            RecommendationStatus   @default(PENDING_APPROVAL)

  reason            String
  evidence          Json
  expectedImpact    String                 @map("expected_impact")
  confidence        Float
  riskLevel         String                 @map("risk_level")
  proposedChange    Json                   @map("proposed_change")
  paramsHash        String                 @map("params_hash")

  // --- Phase 11.5 evidence/state binding --------------------------------
  diagnosisId       String?                @map("diagnosis_id")
  diagnosisCategory String?                @map("diagnosis_category")
  anomalyIds        Json                   @default("[]") @map("anomaly_ids")
  currentState      Json?                  @map("current_state")
  proposedState     Json?                  @map("proposed_state")
  preconditions     Json                   @default("[]")
  evidenceHash      String?                @map("evidence_hash")
  stateHash         String?                @map("state_hash")
  identityHash      String?                @map("identity_hash")
  requiresApproval  Boolean                @default(true) @map("requires_approval")
  staleReasons      Json?                  @map("stale_reasons")
  priority          String                 @default("MEDIUM") @map("priority")
  historicalEvidenceIds Json               @default("[]") @map("historical_evidence_ids")
  confidenceExplanation Json?                @map("confidence_explanation")
  approvalId        String?                @map("approval_id")
  executionId       String?                @map("execution_id")

  expiresAt         DateTime               @map("expires_at")
  approvedAt        DateTime?              @map("approved_at")
  rejectedAt        DateTime?              @map("rejected_at")
  executedAt        DateTime?              @map("executed_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  account MarketingAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  outcome DecisionRecord?
  outcomeRecord OutcomeRecord?

  @@index([userId, status])
  @@index([accountId, targetId])
  @@index([accountId, targetId, status])
  @@index([paramsHash])
  @@map("PerformanceRecommendation")
}

model DecisionRecord {
  id                 String   @id @default(cuid())
  recommendationId   String   @unique @map("recommendation_id")
  accountId          String   @map("account_id")
  executionId        String   @map("execution_id")
  
  baselineMetrics    Json     @map("baseline_metrics")
  postMetrics        Json?    @map("post_metrics")
  measuredAt         DateTime? @map("measured_at")
  
  outcomeRating      String?  @map("outcome_rating")
  kpiDeltaPercent    Float?   @map("kpi_delta_percent")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  recommendation PerformanceRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  account MarketingAccount                 @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
  @@map("DecisionRecord")
}

// ---------------------------------------------------------------------------
// Phase 11.7A — OutcomeRecord
// ---------------------------------------------------------------------------
// Authoritative, immutable-once-finalized measurement of whether an approved
// marketing action produced its intended outcome.
//
// Rules enforced at the repository layer:
//   - baselineSnapshot is written ONCE at creation and NEVER updated.
//   - isFinal = true → no further updates are allowed (idempotent finalize).
//   - Unique per recommendationId → one outcome per recommendation.
//   - Account + userId isolation enforced on every read/write.
// ---------------------------------------------------------------------------
model OutcomeRecord {
  // --- Core identifiers ---
  outcomeId          String            @id @default(cuid())   @map("outcome_id")
  recommendationId   String            @unique                 @map("recommendation_id")
  executionId        String                                    @map("execution_id")
  userId             String                                    @map("user_id")
  accountId          String                                    @map("account_id")
  diagnosisCategory  String?                                   @map("diagnosis_category")

  // --- Entity context ---
  entityType         PerformanceLevel                          @map("entity_type")
  entityId           String                                    @map("entity_id")
  actionType         OptimizationActionType                    @map("action_type")
  objective          String?                                   @map("objective")
  primaryMetric      String                                    @map("primary_metric")

  // --- Immutable baseline (written once at create, NEVER updated) ---
  baselineSnapshot   Json                                      @map("baseline_snapshot")

  // --- Current measurement (updated as data arrives, frozen at FINALIZED) ---
  measurementKpis    Json?                                     @map("measurement_kpis")
  comparison         Json?                                     @map("comparison")

  // --- Outcome verdict (null until FINALIZED) ---
  outcomeEnum        OutcomeEnum?                              @map("outcome_enum")
  confidence         Float?                                    @map("confidence")
  dataQuality        String?                                   @map("data_quality")

  // --- Attribution & confounders ---
  attributionStatus  String                                    @map("attribution_status")
  confounders        Json                                      @default("[]") @map("confounders")
  measurementWindow  Json                                      @map("measurement_window")

  // --- Lifecycle ---
  measurementState   MeasurementState  @default(SCHEDULED) @map("measurement_state")
  /// Once isFinal = true, all columns are frozen. Repository MUST enforce this.
  isFinal            Boolean           @default(false)         @map("is_final")
  measuredAt         DateTime?                                 @map("measured_at")
  createdAt          DateTime          @default(now())          @map("created_at")
  updatedAt          DateTime          @updatedAt               @map("updated_at")

  recommendation PerformanceRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  account        MarketingAccount           @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  revisions      OutcomeRevision[]

  @@index([userId, accountId], map: "outcome_records_user_account_idx")
  @@index([userId, accountId, diagnosisCategory], map: "outcome_records_user_account_category_idx")
  @@index([accountId, measurementState], map: "outcome_records_account_state_idx")
  @@index([recommendationId], map: "outcome_records_recommendation_idx")
  @@index([createdAt], map: "outcome_records_created_at_idx")
  @@map("OutcomeRecord")
}

model OutcomeRevision {
  id                 String            @id @default(cuid())   @map("id")
  outcomeId          String                                    @map("outcome_id")
  revisionNumber     Int                                       @map("revision_number")
  outcomeEnum        OutcomeEnum                               @map("outcome_enum")
  confidence         Float                                     @map("confidence")
  dataQuality        String                                    @map("data_quality")
  attributionStatus  String                                    @map("attribution_status")
  confounders        Json                                      @map("confounders")
  measurementKpis    Json                                      @map("measurement_kpis")
  comparison         Json                                      @map("comparison")
  measuredAt         DateTime                                  @map("measured_at")
  createdAt          DateTime          @default(now())          @map("created_at")

  outcomeRecord      OutcomeRecord     @relation(fields: [outcomeId], references: [outcomeId], onDelete: Cascade)

  @@unique([outcomeId, revisionNumber], map: "outcome_revisions_unique_idx")
  @@index([outcomeId], map: "outcome_revisions_outcome_idx")
  @@map("OutcomeRevision")
}


// ---------------------------------------------------------------------------
// V3 — Command Center tasks and reminders.
//
// Persisted server-side because a reminder that lives in a browser tab is not a
// reminder. This is also what lets JARVIS create one from a spoken request and
// have it still be there tomorrow.
//
// Scoped by userId with a compound index on (userId, dueAt): every query this
// feature makes is "my tasks, ordered by when they are due", and that index is
// what keeps it a range scan rather than a full table scan per dashboard load.
//
// `completedAt` is a timestamp rather than a boolean so "when did I finish
// this" is answerable, and so completion is idempotent.
// ---------------------------------------------------------------------------
/// Tasks and reminders (V3) AND, since Core V1, JARVIS work tasks.
///
/// ONE table on purpose. A work task is a task: it belongs to a user, has a
/// title, and is either outstanding or finished. Splitting it into a second
/// model would have given the Tasks widget, the reminder sweep and the
/// `tasks.list` tool two places to look, which is the duplication the
/// integration rule exists to prevent.
///
/// The three Core V1 columns are ADDITIVE. Nothing that existed reads them,
/// and the two existing behaviours are unaffected:
///   - the reminder sweep requires `dueAt != null`, and a work task carries no
///     due date in this slice, so it can never be surfaced as a reminder;
///   - every list/complete path keys off `completedAt`, which the lifecycle
///     keeps in lockstep with `status` in BOTH directions (see
///     PrismaTaskRepository) so the two can never disagree.
///
/// `createdBy` already distinguishes the two kinds — it predates this change
/// and means "which agent or flow created it, null when manual" — so no
/// discriminator column was added.
model Task {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  title       String
  description String?
  /// Null means "someday": a task with no deadline, which is never overdue.
  dueAt       DateTime? @map("due_at")
  priority    String    @default("NORMAL")
  /// Core V1 lifecycle: PENDING | RUNNING | COMPLETED | FAILED.
  /// A plain String, matching `priority` above, rather than a Prisma enum:
  /// the lifecycle is enforced in one place (TaskService) and a database enum
  /// would need a migration to add a state the service already rejects.
  status      String    @default("PENDING")
  /// When the work actually began. Null for anything never started.
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  /// Why a run failed, in the user's terms. Null unless status is FAILED.
  error       String?
  /// Scheduler V1 — when this WORK task becomes eligible for execution.
  ///
  /// Deliberately NOT `dueAt`. That field belongs to the todo surface: it is
  /// user-writable through PATCH /command-center/tasks/:id, so editing a due
  /// date would silently reschedule real execution, and `dueForReminder()`
  /// keys on it, so wiring reminders later would announce work tasks as
  /// reminders. Core V1.1 separated those two meanings on purpose.
  ///
  /// It is also the CONSUMPTION marker: the scheduler claims a due task by
  /// setting this back to null in the same atomic statement that selects it,
  /// so no second "already run" column is needed and a task cannot be picked
  /// up twice — not by a second tick, not by a second replica, and not by a
  /// task later reopened through the todo checkbox.
  scheduledAt DateTime? @map("scheduled_at")
  /// Task Engine V2.1 - when the scheduler took ownership of this schedule.
  ///
  /// The claim marker. Before V2.1 the claim was expressed by clearing
  /// `scheduledAt`, which destroyed the only record of when the task was meant
  /// to run AND left a crash between the claim and the start indistinguishable
  /// from a task that was never scheduled - the work was silently lost.
  ///
  /// Now the claim SETS this and LEAVES `scheduledAt` intact. The compare-and-
  /// set moves to this column (`claimed_at IS NULL` in the WHERE), so the
  /// exactly-once guarantee is unchanged: still one conditional statement,
  /// still exactly one winner across replicas.
  claimedAt   DateTime? @map("claimed_at")
  /// Task Engine V2.1 - the execution this task performed.
  ///
  /// Correlates the task with its `AuditLog` row, whose `metadata.executionId`
  /// the ToolExecutor writes for every execution. It is NOT a foreign key to
  /// `ToolExecution`: that journal is opt-in per tool and the tools a task
  /// runs do not write to it. See the V2.1 notes in the implementation plan.
  ///
  /// Recorded BEFORE the tool runs, so a run that crashes mid-flight is still
  /// attributable. Null on every historical row and on any task that has not
  /// executed.
  executionId String?   @map("execution_id")
  /// Set once a reminder has been surfaced, so it is not raised twice.
  remindedAt  DateTime? @map("reminded_at")
  /// Which agent or flow created it, for the audit trail. Null when manual.
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, completedAt])
  @@index([userId, status])
  /// The scheduler sweep's only query: due work, by state.
  @@index([scheduledAt, status])
  @@map("Task")
}

// ---------------------------------------------------------------------------
// Google Maps monthly usage guard.
//
// A JARVIS-side cost ceiling. It is NOT a replacement for Google's own billing
// controls — a Cloud budget alert and a quota cap still belong in the console.
// What this adds is a limit JARVIS itself enforces before a request leaves the
// process, so a runaway loop is stopped by our code rather than by a bill.
//
// ONE ROW PER (period, user, service).
//
//   - `period` is the calendar month in UTC, "2026-09". The monthly reset is
//     therefore IMPLICIT: a new month simply writes to new rows. There is no
//     scheduled reset job, so there is no reset job that can fail to run and
//     silently carry a full counter into a new month.
//
//   - `userId` gives per-user attribution, which is what "per-tenant usage"
//     means in this codebase — there is no separate tenant model, the user IS
//     the isolation boundary everywhere else.
//
//   - `service` splits Places / Geocoding / Routes / Autocomplete, because they
//     are priced differently and an operator needs to see which one is running.
//
// Rows are never deleted on rollover; the history is the usage report.
// ---------------------------------------------------------------------------
model MapsUsage {
  id        String   @id @default(cuid())
  /// Calendar month in UTC, formatted "YYYY-MM".
  period    String
  userId    String   @map("user_id")
  /// "places" | "autocomplete" | "place_details" | "geocoding" | "routes"
  service   String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([period, userId, service], map: "maps_usage_period_user_service_unique")
  @@index([period], map: "maps_usage_period_idx")
  @@index([period, userId], map: "maps_usage_period_user_idx")
  @@map("MapsUsage")
}

// ---------------------------------------------------------------------------
// Phase 15 — the Marketing Operating System.
//
// Four tables, all JARVIS's own records: a campaign workspace, the content
// planned in it, and the reports and page research saved for it. Nothing here
// is a copy of a provider's data model, and nothing here causes anything
// outside JARVIS to change — a row in `ContentItem` is a PLAN.
//
// OWNERSHIP AND SCOPE, the same two rules Phase 14 set for memory.
//
//   - `userId` is the owner, and every query filters on it. There is no row a
//     second user can read by knowing its id.
//   - `projectId` is the scope: NULL is personal, otherwise ONE project of the
//     same user. Each table references `Project` by BOTH columns, so the
//     database itself refuses a row in a project its owner does not own.
//     A content item, a report or a piece of research that belongs to a
//     campaign references it by (id, owner) for the same reason, and carries
//     the project of that campaign — which is fixed when the campaign is
//     created and never changes, so the two cannot drift apart.
//
// STATUS COLUMNS ARE STRINGS, matching `Task.status`: the lifecycle is
// enforced in one place (`packages/core`), and a database enum would need a
// migration to add a state the code already rejects.
// ---------------------------------------------------------------------------

model MarketingCampaign {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  /// NULL: personal. Fixed at creation.
  projectId       String?   @map("project_id")
  name            String
  objective       String?
  brief           String?
  /// PLANNING | ACTIVE | PAUSED | COMPLETED | ARCHIVED
  status          String    @default("PLANNING")
  channels        String[]  @default([])
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  /// Meta campaign ids this workspace reports on. Empty: the whole ad account.
  metaCampaignIds String[]  @default([]) @map("meta_campaign_ids")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?            @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  content  ContentItem[]
  reports  MarketingReport[]
  research MarketingResearch[]

  /// Exists so the three tables below can reference a campaign by (id, owner).
  @@unique([id, userId])
  @@index([userId, projectId])
  @@map("MarketingCampaign")
}

model ContentItem {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  campaignId       String?   @map("campaign_id")
  /// The project of its campaign, or the scope it was created in. NULL: personal.
  projectId        String?   @map("project_id")
  title            String
  /// FACEBOOK | INSTAGRAM | LINKEDIN | X | YOUTUBE | WHATSAPP | EMAIL | BLOG | OTHER
  channel          String
  format           String    @default("POST")
  /// The copy. This and `link` are exactly what a publish would send.
  body             String    @default("")
  link             String?
  notes            String?
  /// IDEA | DRAFT | READY | PUBLISHED | ARCHIVED. PUBLISHED is never written
  /// by a status change — only together with the publication columns below.
  status           String    @default("DRAFT")
  /// The calendar date the item is planned for. A plan, not a trigger:
  /// nothing runs on this date.
  scheduledDate    DateTime? @map("scheduled_date") @db.Date
  /// "HH:MM", a wall-clock label. Not an instant: there is no user timezone.
  scheduledTime    String?   @map("scheduled_time")

  /// NONE | PUBLISHING | UNCONFIRMED. The single-winner claim on a publish:
  /// one conditional UPDATE moves NONE to PUBLISHING, so two executions can
  /// never both post the same item.
  publishState     String    @default("NONE") @map("publish_state")
  publishClaimedAt DateTime? @map("publish_claimed_at")
  /// The last attempt that did not end in a verified post: a fixed code, the
  /// target, and the post id when the provider returned one. Never the text.
  publishAttempt   Json?     @map("publish_attempt")

  /// VERIFIED (JARVIS published it and read it back) | REPORTED_BY_USER (the
  /// user said they posted it). NULL: not published.
  publicationMode  String?   @map("publication_mode")
  publishedAt      DateTime? @map("published_at")
  publishedVia     String?   @map("published_via")
  publishedTarget  String?   @map("published_target")
  externalId       String?   @map("external_id")
  externalUrl      String?   @map("external_url")
  verifiedAt       DateTime? @map("verified_at")

  /// "user" | "jarvis"
  createdBy        String    @default("user") @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign? @relation(fields: [campaignId, userId], references: [id, userId], onDelete: Cascade)
  project  Project?           @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  /// The query the calendar makes: one user, a date window.
  @@index([userId, scheduledDate])
  @@index([userId, campaignId])
  @@index([userId, projectId])
  @@index([userId, status])
  @@map("ContentItem")
}

model MarketingReport {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  campaignId      String?  @map("campaign_id")
  projectId       String?  @map("project_id")
  /// PERFORMANCE | CLIENT
  kind            String
  title           String
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  /// The whole report, as built: figures, where each came from, the notes.
  /// A report is a record of what the data said when it was generated, so it
  /// is stored complete and is never recomputed.
  document        Json
  sourcesIncluded Int      @default(0) @map("sources_included")
  sourcesTotal    Int      @default(0) @map("sources_total")
  generatedAt     DateTime @default(now()) @map("generated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign? @relation(fields: [campaignId, userId], references: [id, userId], onDelete: Cascade)
  project  Project?           @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([userId, campaignId])
  @@index([userId, projectId])
  @@map("MarketingReport")
}

model MarketingResearch {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  campaignId String?  @map("campaign_id")
  projectId  String?  @map("project_id")
  /// SEO_AUDIT | COMPETITOR_SNAPSHOT
  kind       String
  /// The host that was read, lower-case, without "www.".
  host       String
  /// The address the content came from, after redirects.
  url        String
  headline   String
  /// How the page was fetched: addresses, status, time, size. Never the HTML.
  provenance Json
  /// The audit or the comparison: facts read from the page, and checks.
  result     Json
  fetchedAt  DateTime @map("fetched_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign? @relation(fields: [campaignId, userId], references: [id, userId], onDelete: Cascade)
  project  Project?           @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  /// "The last read of this page" — what a comparison is made against.
  @@index([userId, kind, url, fetchedAt])
  @@index([userId, projectId])
  @@index([userId, campaignId])
  @@map("MarketingResearch")
}

// ---------------------------------------------------------------------------
// Phase 17, Stage 3A — tenants. A tenant is called an Organization in the
// product; the design is docs/tenant-model-design.md.
//
// A tenant is a business: the ownership and data boundary for TENANT-OWNED
// resources. Today that is only the automation connections the deployment
// configures for everyone (`AutomationConnectorOwner`). Every other row is
// still owned by its user, exactly as before — nothing here re-scopes them.
//
// `TenantRole` is deliberately not `Role`. `Role` is the account-wide role and
// keeps every job it has; on a tenant's resource only the MEMBERSHIP role
// counts, so an account-wide owner who is not a member has no access to it.
//
// Additive: three new tables and one enum, and no row is written by the
// migration. Memberships and connector owners are written ONLY by the operator
// command (packages/db/src/maintenance/tenant-admin.ts), each change in one
// transaction with its audit row.
// ---------------------------------------------------------------------------
enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Tenant {
  id        String   @id @default(cuid())
  /// The Organization's display name. Not an identifier; never used to find it.
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     TenantMembership[]
  connectorOwners AutomationConnectorOwner[]
  approvals       Approval[]
  // Phase 18 — the Automation Library: this Organization's catalogs.
  libraryEntries  AutomationLibraryEntry[]
  librarySyncs    AutomationLibrarySync[]
  // Phase 18.4 — workflow drafts: plans in JARVIS, never sent to n8n.
  automationDrafts AutomationDraft[]
  // Phase 19.6 — desktop agents paired to this Organization's members.
  desktopPairingCodes DesktopPairingCode[]
  desktopDevices      DesktopDevice[]

  @@map("Tenant")
}

// One account's membership in one tenant — the only source of a tenant role.
// It is read by BOTH ids (the unique key below), never by user alone, so a
// membership cannot be found for a tenant other than the one asked about.
model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String     @map("tenant_id")
  userId    String     @map("user_id")
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("TenantMembership")
}

// Which tenant owns a connection configured for the WHOLE deployment by its
// environment — keyed by provider and connector, e.g. n8n's automation
// connection. At most one owner per key. No row: the connection belongs to no
// one, and every request for it is refused. Never inferred from a caller or
// from an account-wide role. `Restrict`: the owning tenant cannot be deleted
// while it owns the connection — ownership is moved or removed first.
model AutomationConnectorOwner {
  id         String   @id @default(cuid())
  providerId String   @map("provider_id")
  connector  String
  tenantId   String   @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([providerId, connector])
  @@index([tenantId])
  @@map("AutomationConnectorOwner")
}

// ---------------------------------------------------------------------------
// Phase 18, Stage 18.1 — the Automation Library: a durable catalog of the
// workflows an n8n instance holds, read from its Public REST API.
//
// NOT THE TRIGGER ALLOW-LIST. `N8nWorkflow` above records which workflows an
// ACCOUNT may trigger (by webhook path) — an outbound security boundary. A
// library entry records that a workflow was SEEN in the instance. The two are
// different facts and stay in different tables: a catalog entry never makes a
// workflow triggerable.
//
// SCOPE. A catalog belongs to the Organization that owns the n8n REST
// connection (`AutomationConnectorOwner`, n8n/rest), for ONE instance:
// `instance_key` is a hash of the configured base URL, never the URL. Every
// read and write names all three, so one Organization never sees another's
// workflows, and pointing the server at another instance starts another
// catalog.
//
// WHAT IS STORED. Listing metadata only — id, name, active state, n8n's own
// timestamps and version id, tag names, node TYPES and count — never a node's
// parameters, a credential, settings, static or pinned data. No secret and no
// provider error text is stored anywhere here.
//
// LIFECYCLE (docs/phases/phase-18.md). A SCAN walks the provider's cursor chain
// from its first page to its last; it may take several bounded RUNS, each
// resuming from the checkpoint the last one saved. A page and the checkpoint
// past it are stored in ONE transaction, fenced by the run's lease. Only a scan
// whose chain ran out is complete; only then are unseen entries reconciled, and
// an entry is marked removed — never deleted — after two consecutive complete
// scans without it.
//
// Additive: three new tables and one enum; no existing column changes.
// ---------------------------------------------------------------------------

enum AutomationLibraryRunStatus {
  RUNNING
  PARTIAL
  COMPLETE
  FAILED
}

model AutomationLibraryEntry {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  providerId       String    @map("provider_id")
  instanceKey      String    @map("instance_key")
  /// The provider's own workflow id — the stable handle.
  externalId       String    @map("external_id")
  name             String
  /// Lower-cased name, tags and node types, for search.
  searchText       String    @map("search_text")
  active           Boolean
  remoteCreatedAt  DateTime? @map("remote_created_at")
  remoteUpdatedAt  DateTime? @map("remote_updated_at")
  versionId        String?   @map("version_id")
  /// Tag names; null when the listing did not say.
  tags             Json?
  /// Node types; null when the listing carried no nodes.
  nodeTypes        Json?     @map("node_types")
  nodeCount        Int?      @map("node_count")
  /// SHA-256 of the stored listing metadata.
  fingerprint      String
  /// The surface that observed it.
  source           String    @default("rest")
  firstSeenAt      DateTime  @map("first_seen_at")
  lastSeenAt       DateTime  @map("last_seen_at")
  lastSeenScanId   String    @map("last_seen_scan_id")
  /// When the fingerprint last changed (first seen, or a changed listing).
  contentChangedAt DateTime  @map("content_changed_at")
  /// Consecutive complete scans this entry was missing from; 0 once seen again.
  missedScans      Int       @default(0) @map("missed_scans")
  missingSince     DateTime? @map("missing_since")
  /// Set after consecutive complete scans without it. The row is never deleted.
  removedAt        DateTime? @map("removed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerId, instanceKey, externalId])
  @@index([tenantId, providerId, instanceKey, name])
  @@index([tenantId, providerId, instanceKey, lastSeenScanId])
  @@map("AutomationLibraryEntry")
}

// One per catalog: the open scan's checkpoint, the last complete scan, and the
// lease that keeps two runs off the same catalog.
model AutomationLibrarySync {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  providerId          String    @map("provider_id")
  instanceKey         String    @map("instance_key")
  /// The open scan; null when none is open (the next run starts one).
  scanId              String?   @map("scan_id")
  /// The provider's cursor for the scan's next page — the resume point. Never returned to a client.
  scanCursor          String?   @map("scan_cursor")
  scanPageSize        Int?      @map("scan_page_size")
  scanPages           Int       @default(0) @map("scan_pages")
  scanRecords         Int       @default(0) @map("scan_records")
  /// SHA-256 of every cursor requested in the open scan, for cycle detection.
  scanCursorTrail     String[]  @default([]) @map("scan_cursor_trail")
  scanStartedAt       DateTime? @map("scan_started_at")
  lastCompleteScanId  String?   @map("last_complete_scan_id")
  lastCompleteAt      DateTime? @map("last_complete_at")
  lastCompleteRecords Int?      @map("last_complete_records")
  /// The run that holds the lease, and until when.
  leaseOwner          String?   @map("lease_owner")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  /// Phase 18.2 — the continue-until-complete chain that holds the catalog, if any.
  activeChainId       String?   @map("active_chain_id")
  /// The holding chain's last sign of life (refreshed between runs and when a run releases the lease).
  chainHeartbeatAt    DateTime? @map("chain_heartbeat_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationLibrarySyncRun[]
  chains AutomationLibrarySyncChain[]

  @@unique([tenantId, providerId, instanceKey])
  @@map("AutomationLibrarySync")
}

enum AutomationLibraryChainStatus {
  RUNNING
  COMPLETE
  STOPPED
  INTERRUPTED
}

/// Phase 18.2 — one continue-until-complete request: bounded runs of one scan,
/// chained until the scan completes or a limit or a refusal stops them. Counts,
/// limits and stable codes only.
model AutomationLibrarySyncChain {
  id              String                       @id
  syncId          String                       @map("sync_id")
  requestedById   String?                      @map("requested_by_id")
  /// The client's key for one click; a retry with it returns this chain.
  idempotencyKey  String?                      @map("idempotency_key")
  status          AutomationLibraryChainStatus
  stopCode        String?                      @map("stop_code")
  failureCode     String?                      @map("failure_code")
  runsStarted     Int                          @default(0) @map("runs_started")
  pagesFetched    Int                          @default(0) @map("pages_fetched")
  recordsObserved Int                          @default(0) @map("records_observed")
  maxRuns         Int                          @map("max_runs")
  maxPages        Int                          @map("max_pages")
  deadlineAt      DateTime                     @map("deadline_at")
  startedAt       DateTime                     @map("started_at")
  heartbeatAt     DateTime                     @map("heartbeat_at")
  finishedAt      DateTime?                    @map("finished_at")

  sync        AutomationLibrarySync      @relation(fields: [syncId], references: [id], onDelete: Cascade)
  requestedBy User?                      @relation("AutomationLibraryChainRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  chainRuns   AutomationLibrarySyncRun[]

  @@unique([syncId, requestedById, idempotencyKey])
  @@index([syncId, startedAt])
  @@map("AutomationLibrarySyncChain")
}

// One bounded run of a scan. Failure is a stable code; its sentence is fixed
// in @jarvis/core — no provider text is stored.
model AutomationLibrarySyncRun {
  id               String                     @id
  syncId           String                     @map("sync_id")
  scanId           String                     @map("scan_id")
  requestedById    String?                    @map("requested_by_id")
  status           AutomationLibraryRunStatus
  /// Continued an open scan rather than starting one.
  resumed          Boolean                    @default(false)
  pagesFetched     Int                        @default(0) @map("pages_fetched")
  recordsObserved  Int                        @default(0) @map("records_observed")
  recordsCreated   Int                        @default(0) @map("records_created")
  recordsUpdated   Int                        @default(0) @map("records_updated")
  recordsUnchanged Int                        @default(0) @map("records_unchanged")
  recordsRejected  Int                        @default(0) @map("records_rejected")
  markedMissing    Int                        @default(0) @map("marked_missing")
  markedRemoved    Int                        @default(0) @map("marked_removed")
  failureCode      String?                    @map("failure_code")
  startedAt        DateTime                   @map("started_at")
  heartbeatAt      DateTime                   @map("heartbeat_at")
  finishedAt       DateTime?                  @map("finished_at")
  /// Phase 18.2 — the chain this run belongs to; null for a single run.
  chainId          String?                    @map("chain_id")

  sync        AutomationLibrarySync       @relation(fields: [syncId], references: [id], onDelete: Cascade)
  requestedBy User?                       @relation("AutomationLibrarySyncRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  chain       AutomationLibrarySyncChain? @relation(fields: [chainId], references: [id], onDelete: SetNull)

  @@index([syncId, startedAt])
  @@index([chainId])
  @@map("AutomationLibrarySyncRun")
}

/// Phase 18.4 — a workflow draft: a plan held in JARVIS, never sent to n8n.
/// It belongs to the Organization that owns the n8n connection, for one
/// instance, like the library catalog it is drafted against.
model AutomationDraft {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  providerId      String   @map("provider_id")
  instanceKey     String   @map("instance_key")
  /// "new" or "customization".
  kind            String
  title           String
  /// A customization's source catalog entry and the version it was drafted from.
  sourceEntryId   String?  @map("source_entry_id")
  sourceVersionId String?  @map("source_version_id")
  /// The newest version. A revision is stored only while this is still the version it was based on.
  latestVersion   Int      @default(1) @map("latest_version")
  /// SHA-256 of the author and the first version's content: the same request twice is one draft.
  createKey       String   @map("create_key")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                    @relation("AutomationDraftAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  versions  AutomationDraftVersion[]

  @@unique([tenantId, providerId, instanceKey, createKey])
  @@index([tenantId, providerId, instanceKey, updatedAt])
  @@map("AutomationDraft")
}

/// One version of a draft. Immutable: PostgreSQL refuses an UPDATE of any of
/// its columns (only an author's deletion may clear created_by_id).
model AutomationDraftVersion {
  id          String   @id @default(cuid())
  draftId     String   @map("draft_id")
  version     Int
  /// The draft's structure and plain answers — no n8n parameter, credential, expression or URL.
  content     Json
  /// SHA-256 of the canonical content.
  contentHash String   @map("content_hash")
  /// The status when it was saved.
  status      String
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  draft     AutomationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AutomationDraftVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([draftId, version])
  @@map("AutomationDraftVersion")
}

// ---------------------------------------------------------------------------
// Phase 19, Stage 19.6 — the Windows desktop agent.
//
// A device belongs to one user in one Organization (D2). It is paired with a
// one-time code, stored only as a hash, and is not active until its user
// confirms the key's fingerprint. The server holds its PUBLIC key only. A grant
// is the person's consent at the device, for a bounded time and scope. A
// command is one approved click, key or typed text, signed by the server, valid
// for 30 seconds, delivered at most once; its parameters are sealed and deleted
// on delivery, and a delivered command with no answer is UNKNOWN, never sent
// again. Every state change is one conditional write.
// ---------------------------------------------------------------------------

enum DesktopDeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum DesktopGrantStatus {
  ACTIVE
  ENDED
}

enum DesktopCommandStatus {
  ISSUED
  DELIVERED
  SUCCEEDED
  NOT_EXECUTED
  UNKNOWN
  EXPIRED
}

/// A pairing code: its SHA-256, never the code. Single use: consumed by ONE
/// conditional UPDATE, which records the device it paired.
model DesktopPairingCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique @map("code_hash")
  /// The Owner/Admin who generated it; the device becomes theirs.
  userId     String    @map("user_id")
  tenantId   String    @map("tenant_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  deviceId   String?   @unique @map("device_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("DesktopPairingCode")
}

/// A paired Windows device. Its public key only; the private key never leaves
/// the device's protected key storage.
model DesktopDevice {
  id                String              @id @default(uuid())
  userId            String              @map("user_id")
  tenantId          String              @map("tenant_id")
  /// Base64 SubjectPublicKeyInfo of the device's ECDSA P-256 key.
  publicKey         String              @map("public_key")
  /// SHA-256 of the public key. One key, one device, ever.
  fingerprint       String              @unique
  displayName       String              @map("display_name")
  /// The names shown on the device's consent screen, as sent to it at pairing.
  userLabel         String              @map("user_label")
  organizationLabel String              @map("organization_label")
  agentVersion      String              @map("agent_version")
  windowsBuild      Int                 @map("windows_build")
  status            DesktopDeviceStatus @default(PENDING)
  createdAt         DateTime            @default(now()) @map("created_at")
  confirmedAt       DateTime?           @map("confirmed_at")
  revokedAt         DateTime?           @map("revoked_at")
  revokedById       String?             @map("revoked_by_id")
  lastSeenAt        DateTime?           @map("last_seen_at")

  user      User             @relation("DesktopDeviceOwner", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User?            @relation("DesktopDeviceRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grants    DesktopGrant[]
  commands  DesktopCommand[]

  @@index([userId])
  @@index([tenantId, status])
  @@map("DesktopDevice")
}

/// Consent given at the device: who may act, on what, until when. At most one
/// ACTIVE per device, held by a lock on the device row.
model DesktopGrant {
  /// Chosen by the agent when the person allows; reported, never reused.
  id                 String             @id
  deviceId           String             @map("device_id")
  /// The agent process that showed the consent. Another process means a restart: the grant ends.
  agentInstanceId    String             @map("agent_instance_id")
  scope              String[]
  durationMinutes    Int                @map("duration_minutes")
  consentTextVersion String             @map("consent_text_version")
  /// SHA-256 of the exact text the person was shown.
  consentTextSha256  String             @map("consent_text_sha256")
  status             DesktopGrantStatus @default(ACTIVE)
  grantedAt          DateTime           @default(now()) @map("granted_at")
  expiresAt          DateTime           @map("expires_at")
  lastContactAt      DateTime           @map("last_contact_at")
  endedAt            DateTime?          @map("ended_at")
  endReason          String?            @map("end_reason")

  device   DesktopDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commands DesktopCommand[]

  @@index([deviceId, status])
  @@map("DesktopGrant")
}

/// One command: what, for which grant, bound to which approval and journal
/// execution, and how it ended. Never its values — those are the sealed
/// payload, deleted when the command is delivered or expires.
model DesktopCommand {
  id            String               @id @default(uuid())
  deviceId      String               @map("device_id")
  grantId       String               @map("grant_id")
  action        String
  paramsHash    String               @map("params_hash")
  requiresHello Boolean              @map("requires_hello")
  approvalId    String?              @unique @map("approval_id")
  executionId   String?              @map("execution_id")
  status        DesktopCommandStatus @default(ISSUED)
  issuedAt      DateTime             @default(now()) @map("issued_at")
  expiresAt     DateTime             @map("expires_at")
  deliveredAt   DateTime?            @map("delivered_at")
  completedAt   DateTime?            @map("completed_at")
  resultCode    String?              @map("result_code")

  device  DesktopDevice          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  grant   DesktopGrant           @relation(fields: [grantId], references: [id], onDelete: Cascade)
  payload DesktopCommandPayload?

  @@index([deviceId, status])
  @@index([status, expiresAt])
  @@map("DesktopCommand")
}

/// A command's parameters, sealed (AES-256-GCM) until delivery.
model DesktopCommandPayload {
  commandId String   @id @map("command_id")
  sealed    String
  expiresAt DateTime @map("expires_at")

  command DesktopCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("DesktopCommandPayload")
}

/// A request nonce, spent once by an INSERT that only one caller can win —
/// across API instances and restarts.
model DesktopRequestNonce {
  /// The device id, or the key fingerprint of a device still pairing.
  scope     String
  nonceHash String   @map("nonce_hash")
  expiresAt DateTime @map("expires_at")

  @@id([scope, nonceHash])
  @@index([expiresAt])
  @@map("DesktopRequestNonce")
}

/// An attempt to redeem a pairing code, by the hash of where it came from:
/// the durable window that rate-limits redemption.
model DesktopPairingAttempt {
  id         String   @id @default(uuid())
  sourceHash String   @map("source_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sourceHash, createdAt])
  @@map("DesktopPairingAttempt")
}
