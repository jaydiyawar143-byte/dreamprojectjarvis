{
  "name": "@jarvis/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./voice": {
      "types": "./dist/types/voice.d.ts",
      "import": "./dist/types/voice.js"
    },
    "./speech": {
      "types": "./dist/speech-preparation.d.ts",
      "import": "./dist/speech-preparation.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "vitest": "^4.1.10"
  }
}
